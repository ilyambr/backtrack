<Window x:Class="Backtrack.PairingRequestOverlay"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Backtrack Pairing Request"
        Width="360"
        SizeToContent="Height"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="False"
        ResizeMode="NoResize"
        Visibility="Hidden">
    <!--
      Not modal (no ShowDialog/Owner): a pairing request can arrive at any time,
      whether or not the HUD happens to be open, same reasoning as the other
      always-available overlays. Centered on screen and Topmost, but still a
      normal click-through-disabled window since Allow/Deny need real clicks.
    -->
    <Border Background="{DynamicResource PanelBg}" BorderBrush="{DynamicResource Hairline}" BorderThickness="1" Padding="22,20">
        <StackPanel>
            <StackPanel Orientation="Horizontal">
                <Ellipse Width="8" Height="8" Fill="{DynamicResource Green}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                <TextBlock Text="Pairing request" FontSize="12" FontWeight="Bold" Foreground="{DynamicResource Text2}" VerticalAlignment="Center"/>
            </StackPanel>

            <TextBlock x:Name="DeviceNameText" Text="A device wants to connect to your clips"
                       FontSize="15" FontWeight="Bold" Foreground="{DynamicResource Text0}" TextWrapping="Wrap" Margin="0,10,0,0"/>

            <Border Background="{DynamicResource RowBg}" BorderBrush="{DynamicResource Hairline}" BorderThickness="1" Margin="0,16,0,0" Padding="0,14">
                <TextBlock x:Name="CodeText" Text="4 8 2 9 1 3" FontSize="28" FontWeight="Bold" Foreground="{DynamicResource Text0}"
                           HorizontalAlignment="Center"/>
            </Border>
            <TextBlock Text="Make sure this matches the code shown on the other PC." FontSize="10.5"
                       Foreground="{DynamicResource Text2}" TextWrapping="Wrap" Margin="0,8,0,0" HorizontalAlignment="Center" TextAlignment="Center"/>

            <TextBlock x:Name="ExpiryText" Text="Expires in 60s" FontSize="10" Foreground="{DynamicResource Text2}"
                       HorizontalAlignment="Center" Margin="0,10,0,0"/>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
                <Button x:Name="DenyButton" Content="Deny" Click="DenyButton_Click"
                        Background="{DynamicResource BorderMedium}" Foreground="{DynamicResource Text0}" BorderThickness="0"
                        Padding="16,8" FontSize="11.5" FontWeight="Bold" Cursor="Hand" Margin="0,0,8,0" Focusable="False"/>
                <Button x:Name="AllowButton" Content="Allow" Click="AllowButton_Click"
                        Background="{DynamicResource Green}" Foreground="{DynamicResource PanelBg}" BorderThickness="0"
                        Padding="16,8" FontSize="11.5" FontWeight="Bold" Cursor="Hand" Focusable="False"/>
            </StackPanel>
        </StackPanel>
    </Border>
</Window>
