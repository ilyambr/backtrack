                                <Button x:Name="TrimSaveNewButton" Content="Save as new clip" Style="{StaticResource FlatButton}" Margin="0,0,8,0" Click="TrimSaveNew_Click"/>
                                <Button Content="Cancel" Style="{StaticResource IconButton}" Margin="0" Click="TrimCancel_Click"/>
                            </StackPanel>
                        </StackPanel>

                        <Grid Margin="16,10,16,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Button x:Name="PlayPauseButton" Grid.Column="0" Style="{StaticResource PlayerTransportButton}" Click="PlayPauseButton_Click">
