                                    <Border.Effect>
                                        <DropShadowEffect BlurRadius="6" ShadowDepth="0" Color="#000000" Opacity="0.5"/>
                                    </Border.Effect>
                                </Border>
                                <Popup x:Name="SeekTooltipPopup" IsOpen="False" AllowsTransparency="True" PlacementTarget="{Binding ElementName=PlayerSeekTrack}" Placement="Top">
