                            <Ellipse Fill="{DynamicResource BorderSubtle}"/>
                            <TextBlock Style="{StaticResource BackButtonGlyph}"/>
                        </Grid>
                        <TextBlock Text="Gallery" Style="{StaticResource ScreenTitle}"/>
                    </StackPanel>
                </Grid>

                <!-- Only shown at all once paired with a transmitter PC (see
                     RefreshGallerySourceTabsVisibility); switches LoadGallery
                     between this PC's own ClipsFolder and the paired PC's, over
                     the pairing connection (see PairingService's list_gallery/
                     get_clip). -->
                <StackPanel x:Name="GallerySourceTabs" DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,12" Visibility="Collapsed">
                    <Button x:Name="GalleryLocalTabButton" Content="This PC" Style="{StaticResource FlatButton}" Margin="0,0,8,0" Click="GalleryLocalTab_Click"/>
                    <Button x:Name="GalleryRemoteTabButton" Content="Remote" Style="{StaticResource FlatButton}" Click="GalleryRemoteTab_Click"/>
                </StackPanel>

                <!-- Folder breadcrumb: collapsed at the clips-folder root, shown once
                     you've navigated into a subfolder via a folder tile below. -->
                <StackPanel x:Name="GalleryPathBar" DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,12" Visibility="Collapsed">
                    <Grid Style="{StaticResource BackButtonHost}" MouseLeftButtonUp="GalleryUp_Click" ToolTip="Up one folder">
                        <Ellipse Fill="{DynamicResource BorderSubtle}"/>
                        <TextBlock Style="{StaticResource BackButtonGlyph}"/>
                    </Grid>
                    <TextBlock x:Name="GalleryPathText" FontSize="11" Foreground="{DynamicResource Text2}" VerticalAlignment="Center"/>
                </StackPanel>

                <!-- Mass-selection bar: collapsed until at least one clip is selected
                     via the hover circle (or a click while already in select mode). -->
                <Grid x:Name="GallerySelectionBar" DockPanel.Dock="Top" Margin="0,0,0,12" Visibility="Collapsed">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock x:Name="GallerySelectionCountText" Text="0 selected" FontSize="12" FontWeight="Bold"
                               Foreground="{DynamicResource Text0}" VerticalAlignment="Center"/>
                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                        <Button Content="Move to folder" Style="{StaticResource IconButton}" Click="MoveSelected_Click"/>
                        <Button Content="Delete" Style="{StaticResource IconButton}" Foreground="{DynamicResource Rec}" Click="DeleteSelected_Click"/>
                        <Button Content="Cancel" Style="{StaticResource IconButton}" Margin="0" Click="CancelSelection_Click"/>
                    </StackPanel>
                </Grid>

                <ScrollViewer x:Name="GalleryScrollHost" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <!-- ItemWidth/ItemHeight, not just each card's own Margin: a plain
                         WrapPanel sizes every row to its tallest child, so if any card's
                         title/date text rendered even slightly differently, that row's
                         gap to the next one would shift; fixing the cell size itself
                         guarantees every row and column lines up exactly the same.
                         240 cell width -> 6 columns fit in BigWidth()'s ~1454px usable
                         content area (1500 max width, minus the panel's 32px margin,
                         2px border, and the scrollbar's own width) with real gutters
                         left over, not just barely squeezing in a 6th. -->
                    <WrapPanel x:Name="GalleryGrid" ItemWidth="240" ItemHeight="168"/>
                </ScrollViewer>
            </DockPanel>

            <!-- Player screen: video + transport on the left, action rail on the right,
                 matching the design concept's layout, not a stacked single column. -->
            <Grid x:Name="PlayerPanel" Visibility="Collapsed">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition/>
                    <ColumnDefinition Width="90"/>
                </Grid.ColumnDefinitions>

                <DockPanel Grid.Column="0">
                    <StackPanel DockPanel.Dock="Bottom" Background="{DynamicResource PanelBg}">
                        <!-- Trim panel: hidden until "Trim" is pressed on the rail -->
