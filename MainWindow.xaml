                                </StackPanel>
                            </Button>
                        </Border>
                        <Border BorderBrush="{DynamicResource Hairline}" BorderThickness="0,0,0,1">
                            <Button Style="{StaticResource TileButton}" Padding="4,14" Click="PlayerFolder_Click">
                                <StackPanel>
                                    <Path Data="M10 4H4c-1.1 0-1.99.9-1.99 2L2 18c0 1.1.89 2 1.99 2H20c1.1 0 2-.9 2-2V8c0-1.1-.9-2-2-2h-8l-2-2z"
                                          Fill="{DynamicResource Text1}" Width="16" Height="16" Stretch="Uniform" HorizontalAlignment="Center" Margin="0,0,0,4"/>
                                    <TextBlock Text="Open folder" FontSize="10.5" FontWeight="Bold" Foreground="{DynamicResource Text1}" HorizontalAlignment="Center" TextAlignment="Center"/>
                                </StackPanel>
                            </Button>
                        </Border>
                        <Button Style="{StaticResource TileButton}" Padding="4,14" Click="PlayerDelete_Click">
                            <StackPanel>
                                <Path Data="M6,19c0,1.1,0.9,2,2,2h8c1.1,0,2,-0.9,2,-2V7H6V19zM19,4h-3.5l-1,-1h-5l-1,1H5v2h14V4z"
                                      Fill="{DynamicResource Rec}" Width="16" Height="16" Stretch="Uniform" HorizontalAlignment="Center" Margin="0,0,0,4"/>
                                <TextBlock Text="Delete" FontSize="10.5" FontWeight="Bold" Foreground="{DynamicResource Rec}" HorizontalAlignment="Center" TextAlignment="Center"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>

                    <StackPanel DockPanel.Dock="Bottom" Margin="10,0,10,14">
                        <Border BorderBrush="{DynamicResource Hairline}" BorderThickness="0,1,0,0" Padding="0,10,0,0">
                            <StackPanel>
                                <TextBlock x:Name="StatSize" FontSize="10" Foreground="{DynamicResource Text2}" TextWrapping="Wrap"/>
                                <TextBlock x:Name="StatResolution" FontSize="10" Foreground="{DynamicResource Text2}" Margin="0,4,0,0"/>
                                <TextBlock x:Name="StatFps" FontSize="10" Foreground="{DynamicResource Text2}" Margin="0,4,0,0"/>
                                <TextBlock x:Name="StatDate" FontSize="10" Foreground="{DynamicResource Text2}" Margin="0,4,0,0" TextWrapping="Wrap"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </DockPanel>
            </Grid>

            <!-- Settings screen -->
            <DockPanel x:Name="SettingsPanel" Visibility="Collapsed" Margin="20,16,20,20">
                <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,14">
                    <Grid Style="{StaticResource BackButtonHost}" MouseLeftButtonUp="BackToIdle_Click">
                        <Ellipse Fill="{DynamicResource BorderSubtle}"/>
                        <TextBlock Style="{StaticResource BackButtonGlyph}"/>
                    </Grid>
                    <TextBlock Text="Settings" Style="{StaticResource ScreenTitle}"/>
                </StackPanel>
                <ScrollViewer x:Name="SettingsScrollHost" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False">
                    <StackPanel Margin="0,0,10,0">
                        <TextBlock Text="APPEARANCE" Style="{StaticResource SettingsSectionHeader}" Margin="0,4,0,10"/>
                        <Border Style="{StaticResource SettingsRow}" BorderThickness="0">
                            <StackPanel>
                                <TextBlock Text="Theme" FontSize="13" FontWeight="Bold" Foreground="{DynamicResource Text0}"/>
                                <TextBlock Text="Applies everywhere -- the HUD and every small overlay window." FontSize="11" Foreground="{DynamicResource Text2}" Margin="0,3,0,14" TextWrapping="Wrap"/>
                                <StackPanel Orientation="Horizontal">
                                    <!-- Each swatch is a tiny fixed mockup of that theme's own real
                                         palette (matching Theme.Dark.xaml/Theme.Light.xaml's literal
                                         values), NOT DynamicResource; these need to keep showing
                                         what dark/light actually look like regardless of which one
                                         is currently active, so they can't react to the live swap. -->
                                    <Border x:Name="DarkThemeSwatch" Width="122" Height="78" CornerRadius="6" Background="#111111"
                                            BorderThickness="2" BorderBrush="Transparent" Cursor="Hand"
                                            MouseLeftButtonUp="DarkThemeSwatch_Click" Margin="0,0,12,0">
                                        <StackPanel Margin="10">
                                            <StackPanel Orientation="Horizontal">
                                                <Ellipse Width="8" Height="8" Fill="#FF5B52" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                                <Rectangle Height="6" Width="46" Fill="#F6F6F6" RadiusX="3" RadiusY="3"/>
                                            </StackPanel>
                                            <Rectangle Height="5" Width="70" Fill="#7E7E7E" RadiusX="2" RadiusY="2" Margin="0,12,0,0"/>
                                            <Rectangle Height="5" Width="50" Fill="#7E7E7E" RadiusX="2" RadiusY="2" Margin="0,6,0,0"/>
                                        </StackPanel>
                                    </Border>
                                    <Border x:Name="LightThemeSwatch" Width="122" Height="78" CornerRadius="6" Background="#F7F7F8"
                                            BorderThickness="2" BorderBrush="Transparent" Cursor="Hand"
                                            MouseLeftButtonUp="LightThemeSwatch_Click" Margin="0,0,12,0">
                                        <StackPanel Margin="10">
                                            <StackPanel Orientation="Horizontal">
                                                <Ellipse Width="8" Height="8" Fill="#FF5B52" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                                <Rectangle Height="6" Width="46" Fill="#16171A" RadiusX="3" RadiusY="3"/>
                                            </StackPanel>
                                            <Rectangle Height="5" Width="70" Fill="#82868E" RadiusX="2" RadiusY="2" Margin="0,12,0,0"/>
                                            <Rectangle Height="5" Width="50" Fill="#82868E" RadiusX="2" RadiusY="2" Margin="0,6,0,0"/>
                                        </StackPanel>
                                    </Border>
                                    <!-- Ported from OBS's own default "Yami" theme palette (see
                                         Theme.Yami.xaml's comment); swatch mockup uses its real
                                         grey/blue scale, not an invented dark variant. -->
                                    <Border x:Name="YamiThemeSwatch" Width="122" Height="78" CornerRadius="6" Background="#1D1F26"
                                            BorderThickness="2" BorderBrush="Transparent" Cursor="Hand"
                                            MouseLeftButtonUp="YamiThemeSwatch_Click">
                                        <StackPanel Margin="10">
                                            <StackPanel Orientation="Horizontal">
                                                <Ellipse Width="8" Height="8" Fill="#718CDC" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                                <Rectangle Height="6" Width="46" Fill="#FFFFFF" RadiusX="3" RadiusY="3"/>
                                            </StackPanel>
                                            <Rectangle Height="5" Width="70" Fill="#969696" RadiusX="2" RadiusY="2" Margin="0,12,0,0"/>
                                            <Rectangle Height="5" Width="50" Fill="#969696" RadiusX="2" RadiusY="2" Margin="0,6,0,0"/>
                                        </StackPanel>
                                    </Border>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                    <TextBlock Text="Dark" Width="134" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource Text2}"/>
