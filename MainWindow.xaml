                                    <StackPanel x:Name="PauseIcon" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                        <Rectangle Width="4" Height="16" Fill="{DynamicResource Text0}" Margin="0,0,4,0"/>
                                        <Rectangle Width="4" Height="16" Fill="{DynamicResource Text0}"/>
                                    </StackPanel>
