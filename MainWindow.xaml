                                        </StackPanel>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsChecked" Value="True">
                                            <Setter TargetName="Brd" Property="Background" Value="{DynamicResource BorderMedium}"/>
                                            <Setter Property="Foreground" Value="{DynamicResource Text0}"/>
                                        </Trigger>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="Brd" Property="Background" Value="{DynamicResource RowHoverBg}"/>
                                        </Trigger>
