                                      DisplayMemberPath="Name" SelectedValuePath="Id" SelectionChanged="AudioTrackCombo_SelectionChanged" ToolTip="Audio track"/>
                            <Button x:Name="PlayerFullscreenButton" Grid.Column="5" Style="{StaticResource TileButton}" Padding="6" Click="ToggleFullscreen_Click" ToolTip="Fullscreen">
                                <Path Data="M7,14H5v5h5v-2H7V14zM5,10h2V7h3V5H5V10zM17,17h-3v2h5v-5h-2V17zM14,5v2h3v3h2V5H14z"
                                      Fill="{DynamicResource Text1}" Width="13" Height="13" Stretch="Uniform"/>
                            </Button>
                        </Grid>
                    </StackPanel>

                    <Grid x:Name="PlayerVideoHost" Background="Black" Height="400">
                        <vlc:VideoView x:Name="PlayerVideoView"/>
                    </Grid>
                </DockPanel>

                <!-- Floats the back button/title over the video's top-left corner, matching
                     the design concept, not a docked bar above it (that reads as a border/
                     gap the concept doesn't have). A Popup, not a plain overlay sibling:
                     VideoView hosts a native HWND for the video surface, and native HWND
                     content always paints over WPF siblings regardless of XAML z-order
                     ("airspace"); Popups are their own top-level window, so this actually
                     renders above the video instead of getting hidden behind it. The
                     lockout bug this caused before is fixed at the source now: CloseOverlay
                     always tears the player down first, so even if this Popup's position
                     were ever to desync, closing the whole HUD still works. -->
                <Popup x:Name="PlayerOverlayPopup" PlacementTarget="{Binding ElementName=PlayerVideoView}" Placement="Relative"
                       HorizontalOffset="0" VerticalOffset="0" AllowsTransparency="True" StaysOpen="True" Focusable="False" IsOpen="False">
                    <Grid Width="{Binding ElementName=PlayerVideoView, Path=ActualWidth}" Height="34">
                        <StackPanel Orientation="Horizontal" Margin="8,0,0,0" VerticalAlignment="Center">
                            <StackPanel.Effect>
                                <DropShadowEffect BlurRadius="6" ShadowDepth="1" Color="Black" Opacity="0.85"/>
                            </StackPanel.Effect>
                            <Grid Style="{StaticResource BackButtonHost}" MouseLeftButtonUp="BackToGallery_Click">
                                <Ellipse Fill="{DynamicResource BorderStrong}"/>
                                <TextBlock Text="&#8249;" FontSize="14" FontWeight="Bold" Foreground="White"
                                           HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,0,1,0"/>
                            </Grid>
                            <TextBlock x:Name="PlayerTitle" Text="Clip" FontWeight="Bold" FontSize="13" Foreground="White" VerticalAlignment="Center"/>
