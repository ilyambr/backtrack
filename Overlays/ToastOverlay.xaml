<Window x:Class="Backtrack.ToastOverlay"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Backtrack Notifications"
        Width="280"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="False"
        ResizeMode="NoResize"
        SizeToContent="Height"
        ShowActivated="False">
    
    <StackPanel x:Name="ToastStack" Margin="0,0,0,0"/>
</Window>
