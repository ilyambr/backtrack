<Window x:Class="Backtrack.LogoOverlay"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Backtrack Logo"
        Width="160" Height="46"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="False"
        ResizeMode="NoResize">
    
    <Grid>
        <Rectangle x:Name="IlyambrLogo" Width="160" Height="46" Opacity="0" CacheMode="BitmapCache">
            <Rectangle.Fill>
                <ImageBrush ImageSource="/Assets/ilyambr.png" Stretch="Uniform" Opacity="0.7"/>
            </Rectangle.Fill>
        </Rectangle>
        <Rectangle x:Name="BacktrackLogo" Width="160" Height="46" Opacity="0" CacheMode="BitmapCache">
            <Rectangle.Fill>
                <ImageBrush ImageSource="/Assets/logo.png" Stretch="Uniform" Opacity="0.7"/>
            </Rectangle.Fill>
        </Rectangle>
    </Grid>
</Window>
