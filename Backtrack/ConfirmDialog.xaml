<Window x:Class="Backtrack.ConfirmDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Backtrack"
        Width="320"
        SizeToContent="Height"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        ResizeMode="NoResize"
        Topmost="True">
    <Border Background="#101113" BorderBrush="#1FFFFFFF" BorderThickness="1" Padding="20,18">
        <StackPanel>
            <TextBlock x:Name="MessageText" Text="Are you sure?" FontSize="13.5" FontWeight="Bold"
                       Foreground="#F5F6F8" TextWrapping="Wrap"/>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0">
                <Button x:Name="CancelButton" Content="Cancel" Click="CancelButton_Click"
                        Background="#1AFFFFFF" Foreground="#F5F6F8" BorderThickness="0"
                        Padding="14,7" FontSize="11.5" FontWeight="Bold" Cursor="Hand" Margin="0,0,8,0" Focusable="False"/>
                <Button x:Name="ConfirmButton" Content="Recycle" Click="ConfirmButton_Click"
                        Background="#FF5B52" Foreground="#101113" BorderThickness="0"
                        Padding="14,7" FontSize="11.5" FontWeight="Bold" Cursor="Hand" Focusable="False"/>
            </StackPanel>
        </StackPanel>
    </Border>
</Window>
