<Window x:Class="Backtrack.OverlayLogWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Backtrack Log"
        Width="480"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="False"
        ResizeMode="NoResize"
        SizeToContent="Height"
        Visibility="Hidden"
        Opacity="0">
    <Window.Resources>
        <SolidColorBrush x:Key="PanelBg" Color="#EC101113"/>
        <SolidColorBrush x:Key="Hairline" Color="#1FFFFFFF"/>
        <SolidColorBrush x:Key="Text0" Color="#F5F6F8"/>
        <SolidColorBrush x:Key="Text2" Color="#767D87"/>
        <SolidColorBrush x:Key="Rec" Color="#FF5B52"/>
    </Window.Resources>
    <Border Background="{StaticResource PanelBg}" BorderBrush="{StaticResource Hairline}" BorderThickness="1">
        <StackPanel>
            <!-- OBS mode: exactly one line, no scrolling; mirrors OBS's own
                 status bar showing one current condition at a time, not a history. -->
            <TextBlock x:Name="ObsModeText" Text="" FontFamily="Consolas" FontSize="11" Foreground="{StaticResource Text0}"
                       Padding="8,5" TextTrimming="CharacterEllipsis" Visibility="Collapsed"/>

            <!-- Backtrack mode: fixed to ~3 lines tall, scrolls for anything older. -->
            <ScrollViewer x:Name="BacktrackModeScroll" MaxHeight="62" VerticalScrollBarVisibility="Auto" Visibility="Collapsed">
                <ItemsControl x:Name="BacktrackModeList" Padding="8,5">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding}" FontFamily="Consolas" FontSize="10.5" Foreground="{StaticResource Text0}"
                                       TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" Margin="0,0,0,2"/>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </StackPanel>
    </Border>
</Window>
