<Window x:Class="CaptureCenter.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Capture Center"
        Width="460" Height="130"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="False"
        ResizeMode="NoResize"
        SizeToContent="Height"
        Loaded="Window_Loaded">
    <Window.Resources>
        <SolidColorBrush x:Key="PanelBg" Color="#E4101113"/>
        <SolidColorBrush x:Key="Hairline" Color="#1FFFFFFF"/>
        <SolidColorBrush x:Key="Text0" Color="#F5F6F8"/>
        <SolidColorBrush x:Key="Text1" Color="#AEB4BD"/>
        <SolidColorBrush x:Key="Text2" Color="#767D87"/>
        <SolidColorBrush x:Key="Accent" Color="#F0A63D"/>
        <SolidColorBrush x:Key="Rec" Color="#FF5B52"/>
        <SolidColorBrush x:Key="Green" Color="#3ECF8E"/>
        <SolidColorBrush x:Key="RowBg" Color="#0BFFFFFF"/>
        <SolidColorBrush x:Key="RowHoverBg" Color="#17FFFFFF"/>
        <SolidColorBrush x:Key="TileHoverBg" Color="#0FFFFFFF"/>

        <Style x:Key="TileButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="6,18,6,20"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{StaticResource TileHoverBg}"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="IconGlyph" TargetType="TextBlock">
            <Setter Property="FontSize" Value="20"/>
            <Setter Property="Foreground" Value="{StaticResource Text0}"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="0,0,0,6"/>
        </Style>

        <Style x:Key="TileLabel" TargetType="TextBlock">
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Foreground" Value="{StaticResource Text0}"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
        </Style>

        <Style x:Key="TileStatus" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Foreground" Value="{StaticResource Text2}"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="0,4,0,0"/>
        </Style>

        <Style x:Key="BufRowButton" TargetType="Button">
            <Setter Property="Background" Value="{StaticResource RowBg}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Foreground" Value="{StaticResource Text0}"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Margin" Value="0,0,0,2"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" Padding="12,10">
                            <ContentPresenter/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{StaticResource RowHoverBg}"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Border Background="{StaticResource PanelBg}" BorderBrush="{StaticResource Hairline}" BorderThickness="1">
        <Grid>
            <Ellipse x:Name="ConnDot" Width="7" Height="7" Fill="{StaticResource Text2}"
                     HorizontalAlignment="Left" VerticalAlignment="Top" Margin="8,8,0,0" ToolTip="OBS connection"/>

            <Button x:Name="SettingsButton" Width="20" Height="20" FontSize="11"
                    HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,6,6,0"
                    Style="{StaticResource TileButton}" Padding="0" Click="SettingsButton_Click"
                    ToolTip="Settings (not built yet)">
                <TextBlock Text="&#9881;" Foreground="{StaticResource Text1}" FontSize="12"/>
            </Button>

            <!-- Idle screen: Record / Save Replay / Gallery -->
            <Grid x:Name="IdlePanel">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition/>
                    <ColumnDefinition/>
                    <ColumnDefinition/>
                </Grid.ColumnDefinitions>

                <Button Grid.Column="0" x:Name="RecordTile" Style="{StaticResource TileButton}" Click="RecordTile_Click">
                    <StackPanel>
                        <Ellipse x:Name="RecordDot" Width="14" Height="14" Fill="{StaticResource Text1}"
                                 HorizontalAlignment="Center" Margin="0,0,0,6"/>
                        <TextBlock x:Name="RecordLabel" Text="Start Recording" Style="{StaticResource TileLabel}"/>
                        <TextBlock x:Name="RecordStatusText" Text=" " Style="{StaticResource TileStatus}"/>
                    </StackPanel>
                </Button>

                <Border Grid.Column="0" Width="1" HorizontalAlignment="Right" Margin="0,26,0,26" Background="{StaticResource Hairline}"/>

                <Button Grid.Column="1" x:Name="SaveReplayTile" Style="{StaticResource TileButton}" Click="SaveReplayTile_Click">
                    <StackPanel>
                        <TextBlock x:Name="SaveReplayIcon" Text="&#8635;" Style="{StaticResource IconGlyph}"/>
                        <TextBlock Text="Save Replay" Style="{StaticResource TileLabel}"/>
                        <TextBlock x:Name="ReplayStatus" Text=" " Style="{StaticResource TileStatus}"/>
                    </StackPanel>
                </Button>

                <Border Grid.Column="1" Width="1" HorizontalAlignment="Right" Margin="0,26,0,26" Background="{StaticResource Hairline}"/>

                <Button Grid.Column="2" x:Name="GalleryTile" Style="{StaticResource TileButton}" Click="GalleryTile_Click">
                    <StackPanel>
                        <UniformGrid Rows="2" Columns="2" Width="18" Height="18" Margin="0,1,0,7" HorizontalAlignment="Center">
                            <Rectangle Width="7" Height="7" Fill="{StaticResource Text0}" Margin="0,0,2,2"/>
                            <Rectangle Width="7" Height="7" Fill="{StaticResource Text0}" Margin="2,0,0,2"/>
                            <Rectangle Width="7" Height="7" Fill="{StaticResource Text0}" Margin="0,2,2,0"/>
                            <Rectangle Width="7" Height="7" Fill="{StaticResource Text0}" Margin="2,2,0,0"/>
                        </UniformGrid>
                        <TextBlock x:Name="GalleryLabel" Text="Gallery" Style="{StaticResource TileLabel}"/>
                        <TextBlock x:Name="GalleryStatus" Text="not built yet" Style="{StaticResource TileStatus}"/>
                    </StackPanel>
                </Button>
            </Grid>

            <!-- Save Replay screen -->
            <DockPanel x:Name="SaveReplayPanel" Visibility="Collapsed" Margin="14,12,14,14">
                <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,10">
                    <TextBlock Text="&#8249;" Foreground="{StaticResource Text2}" FontWeight="Bold" FontSize="14"
                               Margin="0,0,10,0" Cursor="Hand" MouseLeftButtonUp="BackFromSaveReplay_Click"/>
                    <TextBlock Text="Save which buffer?" FontWeight="Bold" FontSize="13" Foreground="{StaticResource Text0}"/>
                </StackPanel>
                <StackPanel x:Name="BufRowsPanel"/>
            </DockPanel>

            <!-- Placeholder for anything not actually built yet (Gallery, Settings) -->
            <DockPanel x:Name="NotBuiltPanel" Visibility="Collapsed" Margin="14,12,14,14">
                <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,10">
                    <TextBlock Text="&#8249;" Foreground="{StaticResource Text2}" FontWeight="Bold" FontSize="14"
                               Margin="0,0,10,0" Cursor="Hand" MouseLeftButtonUp="BackFromNotBuilt_Click"/>
                    <TextBlock x:Name="NotBuiltTitle" Text="Gallery" FontWeight="Bold" FontSize="13" Foreground="{StaticResource Text0}"/>
                </StackPanel>
                <TextBlock x:Name="NotBuiltMessage" TextWrapping="Wrap" FontSize="12" Foreground="{StaticResource Text2}"
                           Text="Not built yet -- see the design mockup for what this screen is meant to do."/>
            </DockPanel>

            <!-- Always-on status indicator, bottom-right, independent of which screen above is open -->
            <StackPanel Orientation="Vertical" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,4,4">
                <Border x:Name="RecBadge" Width="14" Height="14" Background="#CC0A0B0D" BorderBrush="#14FFFFFF" BorderThickness="1"
                        Visibility="Collapsed" ToolTip="Recording">
                    <Ellipse Width="7" Height="7" Fill="{StaticResource Rec}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <Border x:Name="ReplayBadge" Width="14" Height="14" Background="#CC0A0B0D" BorderBrush="#14FFFFFF" BorderThickness="1"
                        Margin="0,1,0,0" Visibility="Collapsed" ToolTip="Replay Buffer Online">
                    <TextBlock Text="&#8635;" FontSize="8" Foreground="{StaticResource Green}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
            </StackPanel>
        </Grid>
    </Border>
</Window>
