    <SolidColorBrush x:Key="Green" Color="#3ECF8E"/>
    
    <SolidColorBrush x:Key="NewestClip" Color="#3B82F6"/>

    <SolidColorBrush x:Key="RowBg" Color="#0B000000"/>
    <SolidColorBrush x:Key="RowHoverBg" Color="#17000000"/>
