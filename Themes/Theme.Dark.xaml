    <sys:Double x:Key="ThemeSortOrder">1</sys:Double>
    <sys:Boolean x:Key="ThemeBuiltIn">true</sys:Boolean>
    <SolidColorBrush x:Key="PanelBg" Color="#101113"/>
    <SolidColorBrush x:Key="PanelBgOpaque" Color="#EC101113"/>
    
    <SolidColorBrush x:Key="ThumbnailBg" Color="#181A1E"/>
