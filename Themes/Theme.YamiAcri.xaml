<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!--
      OBS Studio's "Acri" variant of its own Yami theme (obs-studio's
      themes/Yami_Acri.ovt), same source-of-truth approach as Theme.Yami.xaml
      right next to this file: ported from the real files, not invented.
      Acri is a Yami VARIANT, not a from-scratch theme; its own .ovt only
      overrides the accent/button colors (a moodier navy blue instead of
      Yami's default brighter blue), the neutral grey ramp underneath is
      identical to base Yami. So this file is Theme.Yami.xaml's neutrals
      verbatim, with only Accent swapped to Acri's own palette.

      Acri's .ovt defines the "primary" variable as rgb(19,26,48) (very dark
      navy), "primary_light" as rgb(42,58,117) (the actual hover/interactive
      navy), and a literal button background of #162458. primary_light
      (#2A3A75) is the one that actually shows up as the visible accent in
      practice: button hover, tab hover, toolbutton hover, and scrollbar
      hover all use it, so that's what Accent maps to here, not the
      near-black primary variable or the flat #162458 button base (too
      low-contrast to double as a general highlight color the way
      Backtrack's single Accent key gets used).

      Rec/RecDark/Stream/Green stay Backtrack's own brand colors, same as
      every other theme; see Theme.Dark.xaml's comment on why those don't
      change per theme, only the neutrals/accent borrow the real OBS values.
    -->
    <SolidColorBrush x:Key="PanelBg" Color="#1D1F26"/>
    <SolidColorBrush x:Key="PanelBgOpaque" Color="#EC1D1F26"/>
    <!-- Recessed card surface; see Theme.Dark.xaml's own comment on this key.
         Stays within this theme's own grey ramp (close to RowBg's step),
         not an unrelated invented tone. -->
    <SolidColorBrush x:Key="ThumbnailBg" Color="#252831"/>
    <SolidColorBrush x:Key="Hairline" Color="#3C404D"/>
    <SolidColorBrush x:Key="Text0" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="Text1" Color="#B4B4B4"/>
    <SolidColorBrush x:Key="Text2" Color="#969696"/>
    <SolidColorBrush x:Key="Accent" Color="#2A3A75"/>

    <SolidColorBrush x:Key="Rec" Color="#FF5B52"/>
    <SolidColorBrush x:Key="RecDark" Color="#7A1F1F"/>
    <SolidColorBrush x:Key="Stream" Color="#A855F7"/>
    <SolidColorBrush x:Key="Green" Color="#3ECF8E"/>
    <!-- See Theme.Dark.xaml's own comment on this key: a fixed brand blue,
         same reasoning as Rec/Stream/Green, not derived from Accent. -->
    <SolidColorBrush x:Key="NewestClip" Color="#3B82F6"/>

    <SolidColorBrush x:Key="RowBg" Color="#272A33"/>
    <SolidColorBrush x:Key="RowHoverBg" Color="#3C404D"/>
    <SolidColorBrush x:Key="TileHoverBg" Color="#323540"/>
    <SolidColorBrush x:Key="BorderSubtle" Color="#272A33"/>
    <SolidColorBrush x:Key="BorderMedium" Color="#3C404D"/>
    <SolidColorBrush x:Key="BorderStrong" Color="#4E5566"/>
    <SolidColorBrush x:Key="SeekTrackBg" Color="#3C404D"/>
    <SolidColorBrush x:Key="SeekTrackBuffer" Color="#4E5566"/>

    <SolidColorBrush x:Key="BadgeBg" Color="#CC13141A"/>
    <SolidColorBrush x:Key="BadgeBorder" Color="#333C404D"/>
</ResourceDictionary>
