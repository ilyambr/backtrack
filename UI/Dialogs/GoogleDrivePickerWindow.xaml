<Window x:Class="Backtrack.UI.Dialogs.GoogleDrivePickerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Upload to Google Drive"
        Width="540"
        Height="480"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        ResizeMode="NoResize"
        Topmost="True">

    <Border Background="{DynamicResource PanelBgOpaque}" BorderBrush="{DynamicResource Hairline}" BorderThickness="1" CornerRadius="0"
            MouseLeftButtonDown="Header_MouseLeftButtonDown">
        <Border.Effect>
            <DropShadowEffect BlurRadius="24" ShadowDepth="4" Color="Black" Opacity="0.7"/>
        </Border.Effect>
        <Grid Margin="20,18,20,18">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Header -->
            <Grid Grid.Row="0" Margin="0,0,0,14">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Path Data="M403 378.9L239.4 96h161.2l163.6 282.9zm-137.5 23.6L184.9 544h310.5L576 402.5zm-47.4-271.1L64 402.5L144.6 544L301 272.8z"
                          Fill="{DynamicResource Text1}" Width="18" Height="18" Stretch="Uniform" Margin="0,0,10,0"/>
                    <TextBlock Text="Select Google Drive Destination" FontSize="15" FontWeight="Bold" Foreground="{DynamicResource Text0}"/>
                </StackPanel>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <TextBlock x:Name="UserAccountText" FontSize="11" Foreground="{DynamicResource Text2}" VerticalAlignment="Center" Margin="0,0,12,0" TextTrimming="CharacterEllipsis" MaxWidth="180" Cursor="Hand"
                               ContextMenuOpening="UserAccountText_ContextMenuOpening"
                               MouseLeftButtonUp="UserAccountText_MouseLeftButtonUp">
                        <TextBlock.ContextMenu>
                            <ContextMenu Style="{DynamicResource DarkContextMenu}">
                                <MenuItem Header="Sign out" Style="{DynamicResource DarkMenuItem}" Foreground="{DynamicResource Rec}" Click="SignOutMenuItem_Click"/>
                            </ContextMenu>
                        </TextBlock.ContextMenu>
                    </TextBlock>
                    <Button Style="{StaticResource PlayerTransportButton}" Click="CloseButton_Click" Padding="6,2" ToolTip="Close">
                        <Path Data="M19 6.41L17.59 5 12 10.59 6.41 5 5 6.41 10.59 12 5 17.59 6.41 19 12 13.41 17.59 19 19 17.59 13.41 12z"
                              Fill="{DynamicResource Text2}" Width="11" Height="11" Stretch="Uniform"/>
                    </Button>
                </StackPanel>
            </Grid>

            <!-- Navigation Breadcrumbs & Actions Bar -->
            <Border x:Name="NavigationBar" Grid.Row="1" Background="{DynamicResource RowBg}" BorderBrush="{DynamicResource BorderSubtle}" BorderThickness="1" CornerRadius="4" Padding="8,5" Margin="0,0,0,10">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                        <StackPanel x:Name="BreadcrumbsPanel" Orientation="Horizontal" VerticalAlignment="Center"/>
                    </ScrollViewer>

                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="8,0,0,0">
                        <Button x:Name="NewFolderButton" Style="{StaticResource PlayerTransportButton}" Click="NewFolderButton_Click" Padding="6,3" ToolTip="Create new folder">
                            <StackPanel Orientation="Horizontal">
                                <Path Data="M20 6h-8l-2-2H4c-1.11 0-1.99.89-1.99 2L2 18c0 1.11.89 2 2 2h16c1.11 0 2-.89 2-2V8c0-1.11-.89-2-2-2zm-1 8h-3v3h-2v-3h-3v-2h3V9h2v3h3v2z"
                                      Fill="{DynamicResource Text1}" Width="13" Height="13" Stretch="Uniform" Margin="0,0,4,0"/>
                                <TextBlock Text="New" FontSize="11" Foreground="{DynamicResource Text1}"/>
                            </StackPanel>
                        </Button>
                        <Button x:Name="RefreshButton" Style="{StaticResource PlayerTransportButton}" Click="RefreshButton_Click" Padding="6,3" Margin="4,0,0,0" ToolTip="Refresh">
                            <Path Data="M17.65 6.35C16.2 4.9 14.21 4 12 4c-4.42 0-7.99 3.58-7.99 8s3.57 8 7.99 8c3.73 0 6.84-2.55 7.73-6h-2.08c-.82 2.33-3.04 4-5.65 4-3.31 0-6-2.69-6-6s2.69-6 6-6c1.66 0 3.14.69 4.22 1.78L13 11h7V4l-2.35 2.35z"
                                  Fill="{DynamicResource Text1}" Width="12" Height="12" Stretch="Uniform"/>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Inline New Folder Bar (Hidden by default) -->
            <Grid Grid.Row="1" x:Name="NewFolderRow" Background="{DynamicResource RowBg}" Margin="0,0,0,10" Visibility="Collapsed">
                <Grid Margin="8,5">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBox x:Name="NewFolderInput" Background="Transparent" Foreground="{DynamicResource Text0}" BorderBrush="{DynamicResource BorderMedium}" BorderThickness="0,0,0,1" Padding="4,2" FontSize="12" VerticalAlignment="Center" KeyDown="NewFolderInput_KeyDown"/>
                    <Button Grid.Column="1" Content="Create" Style="{StaticResource PlayerTransportButton}" Click="CreateFolderCommit_Click" Margin="6,0,0,0" Foreground="{DynamicResource Green}"/>
                    <Button Grid.Column="2" Content="Cancel" Style="{StaticResource PlayerTransportButton}" Click="CreateFolderCancel_Click" Margin="4,0,0,0" Foreground="{DynamicResource Text2}"/>
                </Grid>
            </Grid>

            <!-- Folder Items View -->
            <Border Grid.Row="2" Background="{DynamicResource PanelBg}" BorderBrush="{DynamicResource Hairline}" BorderThickness="1" CornerRadius="4">
                <Grid>
                    <!-- Login Required View -->
                    <StackPanel x:Name="LoginPanel" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="24" Visibility="Collapsed">
                        <Path Data="M403 378.9L239.4 96h161.2l163.6 282.9zm-137.5 23.6L184.9 544h310.5L576 402.5zm-47.4-271.1L64 402.5L144.6 544L301 272.8z"
                              Fill="{DynamicResource Text1}" Width="38" Height="38" Stretch="Uniform" HorizontalAlignment="Center" Margin="0,0,0,14"/>
                        <TextBlock Text="Log in to Google Drive" FontSize="14" FontWeight="Bold" Foreground="{DynamicResource Text0}" HorizontalAlignment="Center"/>
                        <TextBlock Text="Connect your Google account to upload clips directly to your Drive." FontSize="11.5" Foreground="{DynamicResource Text2}" Margin="0,6,0,18" HorizontalAlignment="Center" TextAlignment="Center" MaxWidth="360"/>
                        <Button x:Name="LoginButton" Click="LoginButton_Click" Cursor="Hand" Focusable="False" HorizontalAlignment="Center">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="LoginBtnBorder" Background="{DynamicResource Accent}" Padding="16,8" CornerRadius="4">
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Center">
                                            <Path Data="M403 378.9L239.4 96h161.2l163.6 282.9zm-137.5 23.6L184.9 544h310.5L576 402.5zm-47.4-271.1L64 402.5L144.6 544L301 272.8z"
                                                  Fill="{DynamicResource AccentInverse}" Width="14" Height="14" Stretch="Uniform" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                            <TextBlock Text="Log in to Google Drive" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource AccentInverse}" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="LoginBtnBorder" Property="Opacity" Value="0.88"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                    </StackPanel>

                    <!-- Loading View -->
                    <StackPanel x:Name="LoadingPanel" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed">
                        <TextBlock x:Name="LoadingMainText" Text="Connecting to Google Drive..." FontSize="12" Foreground="{DynamicResource Text2}" HorizontalAlignment="Center"/>
                        <TextBlock x:Name="LoadingSubText" Text="Check your browser if signing in for the first time." FontSize="10" Foreground="{DynamicResource Text2}" Margin="0,4,0,0" HorizontalAlignment="Center"/>
                        <Button x:Name="LoadingCancelButton" Content="Cancel" Style="{StaticResource PlayerTransportButton}" Click="LoadingCancelButton_Click" Margin="0,12,0,0" HorizontalAlignment="Center" Foreground="{DynamicResource Text2}"/>
                    </StackPanel>

                    <!-- Error View -->
                    <StackPanel x:Name="ErrorPanel" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="20" Visibility="Collapsed">
                        <TextBlock x:Name="ErrorMessageText" Text="Failed to load folders." FontSize="12" Foreground="{DynamicResource Rec}" TextWrapping="Wrap" HorizontalAlignment="Center" TextAlignment="Center" MaxWidth="440"/>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,12,0,0">
                            <Button Content="Retry" Style="{StaticResource PlayerTransportButton}" Click="RefreshButton_Click" Margin="0,0,8,0" Foreground="{DynamicResource Text0}"/>
                            <Button Content="Switch Account / Reconnect" Style="{StaticResource PlayerTransportButton}" Click="ReauthButton_Click" Foreground="{DynamicResource Accent}"/>
                        </StackPanel>
                    </StackPanel>

                    <!-- Empty Folder View -->
                    <StackPanel x:Name="EmptyPanel" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed">
                        <Path Data="M10 4H4c-1.1 0-1.99.9-1.99 2L2 18c0 1.1.89 2 1.99 2H20c1.1 0 2-.9 2-2V8c0-1.1-.9-2-2-2h-8l-2-2z"
                              Fill="{DynamicResource Text2}" Width="28" Height="28" Stretch="Uniform" Opacity="0.4" HorizontalAlignment="Center" Margin="0,0,0,8"/>
                        <TextBlock Text="No subfolders here." FontSize="12" Foreground="{DynamicResource Text2}" HorizontalAlignment="Center"/>
                        <TextBlock Text="You can upload directly into this folder or create a new subfolder." FontSize="11" Foreground="{DynamicResource Text2}" Opacity="0.8" Margin="0,2,0,0" HorizontalAlignment="Center"/>
                    </StackPanel>

                    <!-- Folder List -->
                    <ListBox x:Name="FolderListBox" Background="Transparent" BorderThickness="0" ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             SelectionMode="Single"
                             PreviewMouseRightButtonDown="FolderListBox_PreviewMouseRightButtonDown"
                             MouseDoubleClick="FolderListBox_MouseDoubleClick" SelectionChanged="FolderListBox_SelectionChanged">
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="Background" Value="Transparent"/>
                                <Setter Property="BorderThickness" Value="0"/>
                                <Setter Property="Padding" Value="0"/>
                                <Setter Property="Cursor" Value="Hand"/>
                                <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="ListBoxItem">
                                            <Border x:Name="ItemBorder" Background="{TemplateBinding Background}" Margin="2,1">
                                                <ContentPresenter HorizontalAlignment="Stretch"/>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="ItemBorder" Property="Background" Value="{DynamicResource RowHoverBg}"/>
                                                </Trigger>
                                                <Trigger Property="IsSelected" Value="True">
                                                    <Setter TargetName="ItemBorder" Property="Background" Value="{DynamicResource BorderMedium}"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </ListBox.ItemContainerStyle>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Border Background="Transparent" Padding="10,8" PreviewMouseRightButtonDown="FolderItem_PreviewMouseRightButtonDown">
                                    <Border.ContextMenu>
                                        <ContextMenu Style="{DynamicResource DarkContextMenu}">
                                            <MenuItem Header="Open folder in browser" Style="{DynamicResource DarkMenuItem}" Click="OpenFolderInBrowser_Click"/>
                                        </ContextMenu>
                                    </Border.ContextMenu>
                                    <Grid Background="Transparent">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <Path Data="M10,4H4C2.89,4 2,4.89 2,6V18A2,2 0 0,0 4,20H20A2,2 0 0,0 22,18V8C22,6.89 21.1,6 20,6H12L10,4Z"
                                              Fill="{DynamicResource Text1}" Width="16" Height="14" Stretch="Uniform" Margin="0,0,10,0" VerticalAlignment="Center"/>
                                        <TextBlock Grid.Column="1" Text="{Binding Name}" FontSize="12.5" FontWeight="SemiBold" Foreground="{DynamicResource Text0}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                        <Path Grid.Column="2" Data="M8.59 16.59L13.17 12 8.59 7.41 10 6l6 6-6 6-1.41-1.41z"
                                              Fill="{DynamicResource Text2}" Width="12" Height="12" Stretch="Uniform" Opacity="0.6" VerticalAlignment="Center"/>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>
            </Border>

            <!-- Footer -->
            <Grid Grid.Row="3" Margin="0,14,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="Target Destination:" FontSize="10.5" Foreground="{DynamicResource Text2}"/>
                    <TextBlock x:Name="CurrentTargetPathText" Text="My Drive" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource Text0}" TextTrimming="CharacterEllipsis" Margin="0,2,0,0"/>
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button x:Name="CancelButton" Content="Cancel" Click="CloseButton_Click" Foreground="{DynamicResource Text0}" Margin="0,0,8,0" Cursor="Hand" Focusable="False">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="Bg" Background="{DynamicResource BorderMedium}" Padding="14,7" CornerRadius="4">
                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="Bg" Property="Background" Value="{DynamicResource BorderStrong}"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>

                    <Button x:Name="UploadButton" Content="Upload Here" Click="UploadButton_Click" Foreground="#0A0B0D" FontWeight="SemiBold" Cursor="Hand" Focusable="False">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="Bg" Background="{DynamicResource Green}" Padding="16,7" CornerRadius="4">
                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="Bg" Property="Background" Value="#52E0A0"/>
                                    </Trigger>
                                    <Trigger Property="IsEnabled" Value="False">
                                        <Setter TargetName="Bg" Property="Opacity" Value="0.5"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                </StackPanel>
            </Grid>
        </Grid>
    </Border>
</Window>
