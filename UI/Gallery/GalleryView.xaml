<UserControl x:Class="Backtrack.UI.Gallery.GalleryView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:Backtrack">
    <Grid>
            
            <DockPanel x:Name="GalleryPanel" Visibility="Collapsed" Margin="16,14,16,16">
                <Grid DockPanel.Dock="Top" Margin="0,0,0,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Orientation="Horizontal">
                        <Grid Style="{StaticResource BackButtonHost}" MouseLeftButtonUp="BackToIdle_Click">
                            <Ellipse Fill="{DynamicResource BorderSubtle}"/>
                            <TextBlock Style="{StaticResource BackButtonGlyph}"/>
                        </Grid>
                        <TextBlock Text="Gallery" Style="{StaticResource ScreenTitle}"/>
                    </StackPanel>

                    <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                        
                        <ComboBox x:Name="GallerySortComboBox" Width="140" Margin="0,0,8,0"
                                  Style="{StaticResource ModernComboBox}" SelectionChanged="GallerySortComboBox_SelectionChanged">
                            <ComboBoxItem Content="Starred First" Tag="StarredFirst"/>
                            <ComboBoxItem Content="Starred Only" Tag="StarredOnly"/>
                            <ComboBoxItem Content="Date (Newest)" Tag="DateDesc" IsSelected="True"/>
                            <ComboBoxItem Content="Date (Oldest)" Tag="DateAsc"/>
                            <ComboBoxItem Content="Size (Largest)" Tag="SizeDesc"/>
                            <ComboBoxItem Content="Size (Smallest)" Tag="SizeAsc"/>
                            <ComboBoxItem Content="Name (A-Z)" Tag="NameAsc"/>
                            <ComboBoxItem Content="Name (Z-A)" Tag="NameDesc"/>
                        </ComboBox>

                        <Grid Width="170" VerticalAlignment="Center">
                            <TextBox x:Name="GalleryFilterBox" Background="{DynamicResource RowBg}" Foreground="{DynamicResource Text0}"
                                     CaretBrush="{DynamicResource Text0}" BorderThickness="0" Padding="10,7" TextChanged="GalleryFilterBox_TextChanged"/>
                            <TextBlock x:Name="GalleryFilterPlaceholder" Text="Search clips..." FontSize="12" Foreground="{DynamicResource Text2}"
                                       Margin="10,0,0,0" VerticalAlignment="Center" IsHitTestVisible="False"/>
                        </Grid>
                    </StackPanel>
                </Grid>

                <StackPanel x:Name="GallerySourceTabs" DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,12" Visibility="Collapsed">
                    <Button x:Name="GalleryLocalTabButton" Content="This PC" Style="{StaticResource FlatButton}" Margin="0,0,8,0" Click="GalleryLocalTab_Click"/>
                    <Button x:Name="GalleryRemoteTabButton" Content="Remote" Style="{StaticResource FlatButton}" Click="GalleryRemoteTab_Click"/>
                </StackPanel>

                <StackPanel x:Name="GalleryPathBar" DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,12" Visibility="Collapsed">
                    <Grid x:Name="GalleryBackButtonHost" Style="{StaticResource BackButtonHost}" MouseLeftButtonUp="GalleryUp_Click" ToolTip="Up one folder"
                          AllowDrop="True" DragEnter="GalleryBackButton_DragEnter" DragOver="GalleryBackButton_DragOver" DragLeave="GalleryBackButton_DragLeave" Drop="GalleryBackButton_Drop">
                        <Ellipse x:Name="GalleryBackButtonBg" Fill="{DynamicResource BorderSubtle}"/>
                        <TextBlock Style="{StaticResource BackButtonGlyph}"/>
                    </Grid>
                    <TextBlock x:Name="GalleryPathText" FontSize="11" Foreground="{DynamicResource Text2}" VerticalAlignment="Center"/>
                </StackPanel>

                <Grid x:Name="GallerySelectionBar" DockPanel.Dock="Top" Margin="0,0,0,12" Visibility="Collapsed">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock x:Name="GallerySelectionCountText" Text="0 selected" FontSize="12" FontWeight="Bold"
                               Foreground="{DynamicResource Text0}" VerticalAlignment="Center"/>
                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                        <Button Content="Move to folder" Style="{StaticResource IconButton}" Click="MoveSelected_Click"/>
                        <Button Content="Delete" Style="{StaticResource IconButton}" Foreground="{DynamicResource Rec}" Click="DeleteSelected_Click"/>
                        <Button Content="Cancel" Style="{StaticResource IconButton}" Margin="0" Click="CancelSelection_Click"/>
                    </StackPanel>
                </Grid>

                <Border DockPanel.Dock="Bottom" Margin="0,10,0,0" Padding="12,8" Background="{DynamicResource RowBg}" CornerRadius="4">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <TextBlock x:Name="GalleryTotalStatsText" Grid.Column="0" Text="0 clips · 0 MB" FontSize="11" Foreground="{DynamicResource Text2}" VerticalAlignment="Center"/>

                        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                            
                            <Border Width="110" Height="6" Background="{DynamicResource SeekTrackBg}" CornerRadius="3" VerticalAlignment="Center" Margin="0,0,10,0" ClipToBounds="True">
                                <Border x:Name="GalleryStorageProgressBar" Width="0" Height="6" Background="{DynamicResource Accent}" HorizontalAlignment="Left" CornerRadius="3"/>
                            </Border>
                            
                            <TextBlock x:Name="GalleryStorageText" Text="" FontSize="11" FontWeight="Medium" Foreground="{DynamicResource Text1}" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <ScrollViewer x:Name="GalleryScrollHost" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                              Focusable="False" FocusVisualStyle="{x:Null}"
                              AllowDrop="True" DragEnter="GalleryScrollHost_DragEnter" DragOver="GalleryScrollHost_DragOver" Drop="GalleryScrollHost_Drop">
                    <WrapPanel x:Name="GalleryGrid" ItemWidth="230" ItemHeight="168" HorizontalAlignment="Center" Focusable="False" FocusVisualStyle="{x:Null}"/>
                </ScrollViewer>
            </DockPanel>

    </Grid>
</UserControl>
