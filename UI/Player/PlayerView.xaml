<UserControl x:Class="Backtrack.UI.Player.PlayerView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vlc="clr-namespace:LibVLCSharp.WPF;assembly=LibVLCSharp.WPF"
             xmlns:local="clr-namespace:Backtrack">
    <Grid>
            
            <Grid x:Name="PlayerPanel" Visibility="Collapsed">
                <DockPanel x:Name="PlayerVideoColumnDock">
                    <StackPanel x:Name="PlayerTransportBar" DockPanel.Dock="Bottom" Background="{DynamicResource PanelBg}">
                        <StackPanel x:Name="TrimPanel" Visibility="Collapsed" Margin="16,10,16,16">
                            <Canvas x:Name="TrimRulerCanvas" Height="16"/>
                            <Grid x:Name="TrimTimelineTrack" Height="40" Background="Transparent" Cursor="Hand"
                                  MouseDown="TrimTimelineTrack_MouseDown" MouseMove="TrimTimelineTrack_MouseMove" MouseUp="TrimTimelineTrack_MouseUp"
                                  SizeChanged="TrimTimelineTrack_SizeChanged">
                                <Border x:Name="TrimTrackBg" Height="34" CornerRadius="4" Background="{DynamicResource SeekTrackBg}" VerticalAlignment="Center"/>
                                <Border x:Name="TrimSelectedRange" Height="34" CornerRadius="4" Background="{DynamicResource Accent}" Opacity="0.35"
                                        HorizontalAlignment="Left" VerticalAlignment="Center" Width="0" IsHitTestVisible="False"/>
                                <Canvas x:Name="TrimMarkerCanvas" Height="34" VerticalAlignment="Center" IsHitTestVisible="False"/>
                                <Border x:Name="TrimPlayhead" Width="2" Height="34" CornerRadius="1" Background="#FFFFFF"
                                        HorizontalAlignment="Left" VerticalAlignment="Center" IsHitTestVisible="False"/>
                                <Border x:Name="TrimStartHandle" Width="10" Height="34" CornerRadius="3" Background="{DynamicResource Accent}"
                                        HorizontalAlignment="Left" VerticalAlignment="Center" Cursor="SizeWE" MouseDown="TrimStartHandle_MouseDown">
                                    <Border.Effect>
                                        <DropShadowEffect BlurRadius="6" ShadowDepth="0" Color="#000000" Opacity="0.5"/>
                                    </Border.Effect>
                                </Border>
                                <Border x:Name="TrimEndHandle" Width="10" Height="34" CornerRadius="3" Background="{DynamicResource Accent}"
                                        HorizontalAlignment="Left" VerticalAlignment="Center" Cursor="SizeWE" MouseDown="TrimEndHandle_MouseDown">
                                    <Border.Effect>
                                        <DropShadowEffect BlurRadius="6" ShadowDepth="0" Color="#000000" Opacity="0.5"/>
                                    </Border.Effect>
                                </Border>
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="24,0,0,0" IsHitTestVisible="False">
                                    <TextBlock x:Name="TrimStartText" Text="0:00" FontSize="11.5" FontWeight="Bold" Foreground="{DynamicResource Text0}"/>
                                    <TextBlock Text=" &#8211; " FontSize="11.5" FontWeight="Bold" Foreground="{DynamicResource Text0}"/>
                                    <TextBlock x:Name="TrimEndText" Text="0:00" FontSize="11.5" FontWeight="Bold" Foreground="{DynamicResource Text0}"/>
                                </StackPanel>
                                <TextBlock x:Name="TrimStatusText" Text="" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource Text0}"
                                           VerticalAlignment="Center" HorizontalAlignment="Right" Margin="0,0,10,0" IsHitTestVisible="False"/>
                                <Popup x:Name="TrimHandleTooltipPopup" IsOpen="False" AllowsTransparency="True" PlacementTarget="{Binding ElementName=TrimTimelineTrack}" Placement="Top">
                                    <Border Background="{DynamicResource PanelBg}" BorderBrush="{DynamicResource Hairline}" BorderThickness="1" CornerRadius="4" Padding="6,3" Margin="0,0,0,6">
                                        <TextBlock x:Name="TrimHandleTooltipText" Text="00:00" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource Text0}"/>
                                    </Border>
                                </Popup>
                            </Grid>
                            <Grid Margin="0,10,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel x:Name="TrimActionButtons" Grid.Column="0" Orientation="Horizontal">
                                    <Button x:Name="TrimReplaceButton" Style="{StaticResource BareIconButton}" Padding="8,6" Margin="0,0,4,0" Click="TrimReplace_Click"
                                            ToolTip="Replace original" ToolTipService.InitialShowDelay="1000">
                                        <Path Fill="{DynamicResource Text1}" Stretch="Uniform" Width="16" Height="16"
                                              Data="M17,3H5c-1.11,0 -2,0.9 -2,2v14c0,1.1 0.89,2 2,2h14c1.1,0 2,-0.9 2,-2V7l-4,-4zm-5,16c-1.66,0 -3,-1.34 -3,-3s1.34,-3 3,-3 3,1.34 3,3 -1.34,3 -3,3zm3,-10H5V5h10v4z"/>
                                    </Button>
                                    <Button x:Name="TrimSaveNewButton" Style="{StaticResource BareIconButton}" Padding="8,6" Margin="0,0,4,0" Click="TrimSaveNew_Click"
                                            ToolTip="Save as new clip" ToolTipService.InitialShowDelay="1000">
                                        <Path Fill="{DynamicResource Text1}" Stretch="Uniform" Width="16" Height="16"
                                              Data="M16,1H4c-1.1,0 -2,0.9 -2,2v14h2V3h12V1zm3,4H8c-1.1,0 -2,0.9 -2,2v14c0,1.1 0.9,2 2,2h11c1.1,0 2,-0.9 2,-2V7c0,-1.1 -0.9,-2 -2,-2zm0,16H8V7h11V21z"/>
                                    </Button>
                                    <Button x:Name="PreviewLoopButton" Style="{StaticResource BareIconButton}" Padding="8,6" Margin="0,0,4,0" Click="PreviewLoopButton_Click"
                                            ToolTip="Preview" ToolTipService.InitialShowDelay="1000">
                                        <Grid Width="16" Height="16">
                                            <Path x:Name="PreviewLoopIcon" Fill="{DynamicResource Text1}" Stretch="Uniform" Width="16" Height="16"
                                                  Data="M12,4.5C7,4.5 2.73,7.61 1,12c1.73,4.39 6,7.5 11,7.5s9.27,-3.11 11,-7.5c-1.73,-4.39 -6,-7.5 -11,-7.5zM12,17c-2.76,0 -5,-2.24 -5,-5s2.24,-5 5,-5 5,2.24 5,5 -2.24,5 -5,5zm0,-8c-1.66,0 -3,1.34 -3,3s1.34,3 3,3 3,-1.34 3,-3 -1.34,-3 -3,-3z"/>
                                            <Rectangle x:Name="PreviewStopIcon" Visibility="Collapsed" Fill="{DynamicResource Text1}" Width="12" Height="12" RadiusX="1.5" RadiusY="1.5"/>
                                        </Grid>
                                    </Button>
                                    <Button x:Name="TrimCancelButton" Style="{StaticResource BareIconButton}" Padding="8,6" Click="TrimCancel_Click"
                                            ToolTip="Cancel" ToolTipService.InitialShowDelay="1000">
                                        <Path Fill="{DynamicResource Text1}" Stretch="Uniform" Width="16" Height="16"
                                              Data="M19,6.41L17.59,5 12,10.59 6.41,5 5,6.41 10.59,12 5,17.59 6.41,19 12,13.41 17.59,19 19,17.59 13.41,12z"/>
                                    </Button>
                                </StackPanel>
                                <StackPanel x:Name="TrimTransportExtras" Grid.Column="1" Orientation="Horizontal"/>
                            </Grid>
                        </StackPanel>

                        <Grid x:Name="PlayerTransportRow" Margin="16,10,16,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Button x:Name="PlayPauseButton" Grid.Column="0" Style="{StaticResource PlayerTransportButton}" Click="PlayPauseButton_Click">
                                <Grid Width="16" Height="16">
                                    <StackPanel x:Name="PauseIcon" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                        <Rectangle Width="4" Height="16" Fill="{DynamicResource Text1}" Margin="0,0,4,0"/>
                                        <Rectangle Width="4" Height="16" Fill="{DynamicResource Text1}"/>
                                    </StackPanel>
                                    <Path x:Name="PlayIcon" Visibility="Collapsed" Fill="{DynamicResource Text1}"
                                          Data="M0,0 L0,16 L14,8 Z" Stretch="Uniform" Width="14" Height="16"
                                          HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Grid>
                            </Button>
                            <TextBlock x:Name="PlayerCurrentTime" Grid.Column="1" Text="0:00" FontSize="11.5" FontWeight="Bold"
                                       Foreground="{DynamicResource Text1}" VerticalAlignment="Center" Margin="12,0,10,0"/>
                            <Grid x:Name="PlayerSeekTrack" Grid.Column="2" Height="24" Background="Transparent" Cursor="Hand" VerticalAlignment="Center"
                                  MouseEnter="PlayerSeekTrack_MouseEnter" MouseLeave="PlayerSeekTrack_MouseLeave"
                                  MouseDown="PlayerSeekTrack_MouseDown" MouseMove="PlayerSeekTrack_MouseMove" MouseUp="PlayerSeekTrack_MouseUp">
                                <Border x:Name="PlayerSeekBg" Height="4" CornerRadius="2" Background="{DynamicResource SeekTrackBg}" VerticalAlignment="Center"/>
                                <Border x:Name="PlayerSeekBuffer" Height="4" CornerRadius="2" Background="{DynamicResource SeekTrackBuffer}" HorizontalAlignment="Left" VerticalAlignment="Center" Width="0"/>
                                <Border x:Name="PlayerSeekFill" Height="4" CornerRadius="2" Background="{DynamicResource Accent}" HorizontalAlignment="Left" VerticalAlignment="Center" Width="0"/>
                                <Canvas x:Name="PlayerMarkerCanvas" Height="24" VerticalAlignment="Center" IsHitTestVisible="True"/>
                                <Border x:Name="PlayerSeekThumb" Width="14" Height="14" CornerRadius="7" Background="#FFFFFF" HorizontalAlignment="Left" VerticalAlignment="Center" Visibility="Collapsed" Margin="-7,0,0,0">
                                    <Border.Effect>
                                        <DropShadowEffect BlurRadius="6" ShadowDepth="0" Color="#000000" Opacity="0.5"/>
                                    </Border.Effect>
                                </Border>
                                <Popup x:Name="SeekTooltipPopup" IsOpen="False" AllowsTransparency="True" PlacementTarget="{Binding ElementName=PlayerSeekTrack}" Placement="Top">
                                    <Border Background="{DynamicResource PanelBg}" BorderBrush="{DynamicResource Hairline}" BorderThickness="1" CornerRadius="4" Padding="6,3" Margin="0,0,0,6">
                                        <TextBlock x:Name="SeekTooltipText" Text="00:00" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource Text0}"/>
                                    </Border>
                                </Popup>
                            </Grid>
                            <TextBlock x:Name="PlayerDurationText" Grid.Column="3" Text="0:00" FontSize="11.5" FontWeight="Bold"
                                       Foreground="{DynamicResource Text1}" VerticalAlignment="Center" Margin="10,0,14,0"/>
                            <ComboBox x:Name="AudioTrackCombo" Grid.Column="4" Width="120" Style="{StaticResource ModernComboBox}" Margin="0,0,10,0" Visibility="Collapsed"
                                      DisplayMemberPath="Name" SelectedValuePath="Id" SelectionChanged="AudioTrackCombo_SelectionChanged" ToolTip="Audio track"/>
                            <Button x:Name="PlayerSpeedButton" Grid.Column="5" Style="{StaticResource TileButton}" Padding="10,10"
                                    VerticalAlignment="Center" Click="PlayerSpeedButton_Click" ToolTip="Playback speed">
                                <TextBlock x:Name="PlayerSpeedText" Text="1x" FontSize="12" FontWeight="Bold" Foreground="{DynamicResource Text1}"/>
                            </Button>
                            <Button x:Name="PlayerVolumeButton" Grid.Column="6" Style="{StaticResource TileButton}" Padding="10"
                                    VerticalAlignment="Center" Click="PlayerVolumeButton_Click"
                                    MouseEnter="PlayerVolumeArea_MouseEnter" MouseLeave="PlayerVolumeArea_MouseLeave" ToolTip="Volume">
                                <Grid>
                                    <Path x:Name="PlayerVolumeIcon"
                                          Data="M3,9v6h4l5,5V4L7,9H3z M16.5,12c0,-1.77 -1.02,-3.29 -2.5,-4.03v8.05c1.48,-0.73 2.5,-2.26 2.5,-4.02z M14,3.23v2.06c2.89,0.86 5,3.54 5,6.71s-2.11,5.85 -5,6.71v2.06c4.01,-0.91 7,-4.49 7,-8.77s-2.99,-7.86 -7,-8.77z"
                                          Fill="{DynamicResource Text1}" Width="15" Height="15" Stretch="Uniform"/>
                                    <Popup x:Name="PlayerVolumePopup" IsOpen="False" AllowsTransparency="True" StaysOpen="True" Focusable="False"
                                           PlacementTarget="{Binding ElementName=PlayerVolumeButton}" Placement="Top">
                                        <Border Background="{DynamicResource PanelBg}" BorderBrush="{DynamicResource Hairline}" BorderThickness="1"
                                                Padding="10,14" Margin="0,0,0,8"
                                                MouseEnter="PlayerVolumeArea_MouseEnter" MouseLeave="PlayerVolumeArea_MouseLeave">
                                            <Slider x:Name="PlayerVolumeSlider" Orientation="Vertical" Height="90" Width="20"
                                                    Minimum="0" Maximum="100" Value="100" SmallChange="5" LargeChange="20"
                                                    ValueChanged="PlayerVolumeSlider_ValueChanged"/>
                                        </Border>
                                    </Popup>
                                </Grid>
                            </Button>
                            <Button x:Name="PlayerFullscreenButton" Grid.Column="7" Style="{StaticResource TileButton}" Padding="14"
                                    VerticalAlignment="Center" Click="ToggleFullscreen_Click" ToolTip="Fullscreen">
                                <Path x:Name="PlayerFullscreenIcon" Data="M7,14H5v5h5v-2H7V14zM5,10h2V7h3V5H5V10zM17,17h-3v2h5v-5h-2V17zM14,5v2h3v3h2V5H14z"
                                      Fill="{DynamicResource Text1}" Width="13" Height="13" Stretch="Uniform"/>
                            </Button>
                        </Grid>
                    </StackPanel>

                    <Grid x:Name="PlayerVideoHost" Background="Black" Height="400">
                        <vlc:VideoView x:Name="PlayerVideoView"/>
                    </Grid>
                </DockPanel>

                <Popup x:Name="PlayerOverlayPopup" PlacementTarget="{Binding ElementName=PlayerVideoView}" Placement="Relative"
                       HorizontalOffset="10" VerticalOffset="10" AllowsTransparency="True" StaysOpen="True" Focusable="False" IsOpen="False">
                    <Grid x:Name="PlayerTitleBarHost" Width="{Binding ElementName=PlayerVideoView, Path=ActualWidth}" Height="46">
                        <Border x:Name="PlayerTitlePill" Background="{DynamicResource PanelBgOpaque}" CornerRadius="18" Padding="10,7"
                                HorizontalAlignment="Left" VerticalAlignment="Center">
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="10" ShadowDepth="1" Color="Black" Opacity="0.5"/>
                            </Border.Effect>
                            <StackPanel x:Name="PlayerTitleBar" Orientation="Horizontal" VerticalAlignment="Center">
                                <Grid Style="{StaticResource BackButtonHost}" MouseLeftButtonUp="BackToGallery_Click">
                                    <Ellipse Fill="{DynamicResource BorderStrong}"/>
                                    <TextBlock Text="&#8249;" FontSize="14" FontWeight="Bold" Foreground="{DynamicResource Text0}"
                                               HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,0,1,0"/>
                                </Grid>
                                <TextBlock x:Name="PlayerTitle" Text="Clip" FontWeight="Bold" FontSize="13" Foreground="{DynamicResource Text0}" VerticalAlignment="Center"
                                           Cursor="Hand" MouseLeftButtonDown="PlayerTitle_MouseLeftButtonDown" ToolTip="Double-click to rename"/>
                                
                                <Button x:Name="PlayerStarButton" Style="{StaticResource BareIconButton}" Margin="8,0,0,0" Padding="4,2"
                                        Click="PlayerStarButton_Click" ToolTip="Toggle Favorite / Starred">
                                    <TextBlock x:Name="PlayerStarGlyph" Text="☆" FontSize="13" Foreground="{DynamicResource Text2}"/>
                                </Button>
                            </StackPanel>
                        </Border>

                        <Border x:Name="PlayerMenuPill" Width="34" Height="34" CornerRadius="17" Background="{DynamicResource PanelBgOpaque}"
                                HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,20,0"
                                Cursor="Hand" MouseLeftButtonUp="PlayerMenuButton_Click" ToolTip="Clip options &amp; details">
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="10" ShadowDepth="1" Color="Black" Opacity="0.5"/>
                            </Border.Effect>
                            <Path Data="M12,8c1.1,0 2,-0.9 2,-2s-0.9,-2 -2,-2 -2,0.9 -2,2 0.9,2 2,2zm0,2c-1.1,0 -2,0.9 -2,2s0.9,2 2,2 2,-0.9 2,-2 -0.9,-2 -2,-2zm0,6c-1.1,0 -2,0.9 -2,2s0.9,2 2,2 2,-0.9 2,-2 -0.9,-2 -2,-2z"
                                  Fill="{DynamicResource Text0}" Width="16" Height="16" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"
                                  IsHitTestVisible="False"/>
                        </Border>
                    </Grid>
                </Popup>

                <Popup x:Name="PlayerMenuPopup" PlacementTarget="{Binding ElementName=PlayerMenuPill}" Placement="Bottom"
                       HorizontalOffset="-190" VerticalOffset="8" AllowsTransparency="True" StaysOpen="False" Focusable="False" IsOpen="False">
                    <Border Background="{DynamicResource PanelBgOpaque}" BorderBrush="{DynamicResource Hairline}" BorderThickness="1"
                            Padding="8" Width="224">
                        <Border.Effect>
                            <DropShadowEffect BlurRadius="16" ShadowDepth="3" Color="Black" Opacity="0.6"/>
                        </Border.Effect>
                        <StackPanel>
                            
                            <UniformGrid Columns="2" Rows="3">
                                <Button Style="{StaticResource PlayerActionTileButton}" Margin="2" Click="PlayerRename_Click">
                                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                        <Path Data="M3,17.25V21h3.75L17.81,9.94l-3.75,-3.75L3,17.25zM20.71,7.04c0.39,-0.39,0.39,-1.02,0,-1.41l-2.34,-2.34c-0.39,-0.39,-1.02,-0.39,-1.41,0l-1.83,1.83l3.75,3.75L20.71,7.04z"
                                              Fill="{DynamicResource Text1}" Width="15" Height="15" Stretch="Uniform" HorizontalAlignment="Center" Margin="0,0,0,4"/>
                                        <TextBlock Text="Rename" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource Text1}" HorizontalAlignment="Center"/>
                                    </StackPanel>
                                </Button>
                                <Button Style="{StaticResource PlayerActionTileButton}" Margin="2" Click="PlayerTrim_Click">
                                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                        <Path Data="M9.64,7.64c0.23,-0.5,0.36,-1.05,0.36,-1.64c0,-2.21,-1.79,-4,-4,-4S2,3.79,2,6s1.79,4,4,4c0.59,0,1.14,-0.13,1.64,-0.36L10,12l-2.36,2.36C7.14,14.13,6.59,14,6,14c-2.21,0,-4,1.79,-4,4s1.79,4,4,4s4,-1.79,4,-4c0,-0.59,-0.13,-1.14,-0.36,-1.64L12,14l7,7h3v-1L9.64,7.64zM6,8C4.9,8,4,7.1,4,6s0.9,-2,2,-2s2,0.9,2,2S7.1,8,6,8zM6,20c-1.1,0,-2,-0.9,-2,-2s0.9,-2,2,-2s2,0.9,2,2S7.1,20,6,20zM12,13.5c-0.28,0,-0.5,-0.22,-0.5,-0.5s0.22,-0.5,0.5,-0.5s0.5,0.22,0.5,0.5S12.28,13.5,12,13.5zM19,3l-6,6l2,2l7,-7V3H19z"
                                              Fill="{DynamicResource Text1}" Width="15" Height="15" Stretch="Uniform" HorizontalAlignment="Center" Margin="0,0,0,4"/>
                                        <TextBlock Text="Trim" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource Text1}" HorizontalAlignment="Center"/>
                                    </StackPanel>
                                </Button>
                                <Button Style="{StaticResource PlayerActionTileButton}" Margin="2" Click="PlayerCompress_Click">
                                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                        
                                        <Path Data="M19,9h-4V3H9v6H5l7,7 7,-7zM5,18v2h14v-2H5z"
                                              Fill="{DynamicResource Text1}" Width="15" Height="15" Stretch="Uniform" HorizontalAlignment="Center" Margin="0,0,0,4"/>
                                        <TextBlock Text="Compress" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource Text1}" HorizontalAlignment="Center"/>
                                    </StackPanel>
                                </Button>
                                <Button Style="{StaticResource PlayerActionTileButton}" Margin="2" Click="PlayerBookmarks_Click">
                                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                        
                                        <Path Data="M17,3H7c-1.1,0 -1.99,0.9 -1.99,2L5,21l7,-3 7,3V5c0,-1.1 -0.9,-2 -2,-2z"
                                              Fill="{DynamicResource Text1}" Width="15" Height="15" Stretch="Uniform" HorizontalAlignment="Center" Margin="0,0,0,4"/>
                                        <TextBlock Text="Bookmarks" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource Text1}" HorizontalAlignment="Center"/>
                                    </StackPanel>
                                </Button>
                                <Button Style="{StaticResource PlayerActionTileButton}" Margin="2" Click="PlayerFolder_Click">
                                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                        <Path Data="M10 4H4c-1.1 0-1.99.9-1.99 2L2 18c0 1.1.89 2 1.99 2H20c1.1 0 2-.9 2-2V8c0-1.1-.9-2-2-2h-8l-2-2z"
                                              Fill="{DynamicResource Text1}" Width="15" Height="15" Stretch="Uniform" HorizontalAlignment="Center" Margin="0,0,0,4"/>
                                        <TextBlock Text="Open folder" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource Text1}" HorizontalAlignment="Center"/>
                                    </StackPanel>
                                </Button>
                                <Button Style="{StaticResource PlayerActionTileButton}" Margin="2" Click="PlayerDelete_Click">
                                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                        <Path Data="M6,19c0,1.1,0.9,2,2,2h8c1.1,0,2,-0.9,2,-2V7H6V19zM19,4h-3.5l-1,-1h-5l-1,1H5v2h14V4z"
                                              Fill="{DynamicResource Rec}" Width="15" Height="15" Stretch="Uniform" HorizontalAlignment="Center" Margin="0,0,0,4"/>
                                        <TextBlock Text="Delete" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource Rec}" HorizontalAlignment="Center"/>
                                    </StackPanel>
                                </Button>
                            </UniformGrid>

                            <Border BorderBrush="{DynamicResource Hairline}" BorderThickness="0,1,0,0" Margin="2,8,2,8"/>

                            <StackPanel Margin="6,0,6,4">
                                <TextBlock x:Name="StatSize" FontSize="11" Foreground="{DynamicResource Text2}" Margin="0,2,0,0"/>
                                <TextBlock x:Name="StatResolution" FontSize="11" Foreground="{DynamicResource Text2}" Margin="0,3,0,0"/>
                                <TextBlock x:Name="StatFps" FontSize="11" Foreground="{DynamicResource Text2}" Margin="0,3,0,0"/>
                                <TextBlock x:Name="StatBitrate" FontSize="11" Foreground="{DynamicResource Text2}" Margin="0,3,0,0"/>
                                <TextBlock x:Name="StatDate" FontSize="11" Foreground="{DynamicResource Text2}" Margin="0,3,0,0" TextWrapping="Wrap"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </Popup>

                <Popup x:Name="PlayerFullscreenTransportPopup" PlacementTarget="{Binding ElementName=PlayerVideoView}" Placement="Relative"
                       HorizontalOffset="0" AllowsTransparency="True" StaysOpen="True" Focusable="False" IsOpen="False">
                    <Border x:Name="PlayerFullscreenTransportBorder" Background="{DynamicResource PanelBgOpaque}" Padding="20,6">
                        <Border.Effect>
                            <DropShadowEffect BlurRadius="14" ShadowDepth="2" Color="Black" Opacity="0.5"/>
                        </Border.Effect>
                    </Border>
                </Popup>

                <Popup x:Name="PlayerFreezeFramePopup" PlacementTarget="{Binding ElementName=PlayerVideoView}" Placement="Relative"
                       HorizontalOffset="0" VerticalOffset="0" AllowsTransparency="True" StaysOpen="True" Focusable="False" IsOpen="False">
                    <Image x:Name="PlayerFreezeFrame" Stretch="Uniform"
                           Width="{Binding ElementName=PlayerVideoView, Path=ActualWidth}"
                           Height="{Binding ElementName=PlayerVideoView, Path=ActualHeight}"/>
                </Popup>

                <Popup x:Name="PlayerActionFeedbackPopup" PlacementTarget="{Binding ElementName=PlayerVideoView}" Placement="Relative"
                       AllowsTransparency="True" StaysOpen="True" Focusable="False" IsOpen="False">
                    <Border x:Name="PlayerActionFeedbackBorder" Background="{DynamicResource PanelBgOpaque}" Width="110" Height="110">
                        <Border.Effect>
                            <DropShadowEffect BlurRadius="14" ShadowDepth="2" Color="Black" Opacity="0.5"/>
                        </Border.Effect>
                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                            <Path x:Name="PlayerActionFeedbackIcon" Fill="{DynamicResource Text0}" Width="34" Height="34"
                                  Stretch="Uniform" HorizontalAlignment="Center"/>
                            <TextBlock x:Name="PlayerActionFeedbackText" FontWeight="Bold" FontSize="14" Foreground="{DynamicResource Text0}"
                                       HorizontalAlignment="Center" Margin="0,8,0,0"/>
                        </StackPanel>
                    </Border>
                </Popup>

                <Popup x:Name="CompressPopup" PlacementTarget="{Binding ElementName=PlayerMenuPill}" Placement="Bottom"
                       HorizontalOffset="-230" VerticalOffset="8" AllowsTransparency="True" StaysOpen="True" Focusable="False" IsOpen="False">
                    <Border Background="{DynamicResource PanelBgOpaque}" BorderBrush="{DynamicResource Hairline}" BorderThickness="1"
                            Padding="14" Width="260">
                        <Border.Effect>
                            <DropShadowEffect BlurRadius="16" ShadowDepth="3" Color="Black" Opacity="0.6"/>
                        </Border.Effect>
                        <StackPanel>
                            <Grid Margin="0,0,0,10">
                                <TextBlock Text="Compress Clip" FontWeight="Bold" FontSize="13" Foreground="{DynamicResource Text0}" VerticalAlignment="Center"/>
                                <Button Style="{StaticResource BareIconButton}" HorizontalAlignment="Right" Padding="4,2" Click="CloseCompressPopup_Click" ToolTip="Close">
                                    <Path Data="M19,6.41L17.59,5 12,10.59 6.41,5 5,6.41 10.59,12 5,17.59 6.41,19 12,13.41 17.59,19 19,17.59 13.41,12z"
                                          Fill="{DynamicResource Text2}" Width="10" Height="10" Stretch="Uniform"/>
                                </Button>
                            </Grid>
                            <TextBlock Text="Choose target file size:" FontSize="11" Foreground="{DynamicResource Text2}" Margin="0,0,0,8"/>
                            
                            <UniformGrid x:Name="CompressPresetsGrid" Columns="3" Margin="0,0,0,8">
                                <Button x:Name="CompressPreset10" Content="10 MB" Style="{StaticResource FlatButton}" Margin="2" Padding="4,6" Click="CompressPreset_Click" Tag="10"/>
                                <Button x:Name="CompressPreset25" Content="25 MB" Style="{StaticResource FlatButton}" Margin="2" Padding="4,6" Click="CompressPreset_Click" Tag="25" ToolTip="Discord Standard"/>
                                <Button x:Name="CompressPreset50" Content="50 MB" Style="{StaticResource FlatButton}" Margin="2" Padding="4,6" Click="CompressPreset_Click" Tag="50" ToolTip="Discord Nitro Basic"/>
                                <Button x:Name="CompressPreset100" Content="100 MB" Style="{StaticResource FlatButton}" Margin="2" Padding="4,6" Click="CompressPreset_Click" Tag="100"/>
                                <Button x:Name="CompressPreset250" Content="250 MB" Style="{StaticResource FlatButton}" Margin="2" Padding="4,6" Click="CompressPreset_Click" Tag="250"/>
                                <Button x:Name="CompressCustomButton" Content="Custom" Style="{StaticResource FlatButton}" Margin="2" Padding="4,6" Click="CompressCustomButton_Click"/>
                            </UniformGrid>

                            <Grid x:Name="CompressCustomRow" Visibility="Collapsed" Margin="0,0,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBox x:Name="CompressCustomMbBox" Background="{DynamicResource RowBg}" Foreground="{DynamicResource Text0}"
                                         Padding="8,5" BorderThickness="0" Text="15"/>
                                <TextBlock Grid.Column="1" Text="MB" FontSize="11.5" FontWeight="SemiBold" Foreground="{DynamicResource Text1}" VerticalAlignment="Center" Margin="6,0,0,0"/>
                            </Grid>

                            <Grid Margin="0,4,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Button x:Name="CompressReplaceButton" Grid.Column="0" Style="{StaticResource FlatButton}" Margin="0,0,3,0" Padding="4,7" Click="CompressReplace_Click"
                                        ToolTip="Compress and replace original clip">
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                        <Path Data="M17,3H5c-1.11,0 -2,0.9 -2,2v14c0,1.1 0.89,2 2,2h14c1.1,0 2,-0.9 2,-2V7l-4,-4zm-5,16c-1.66,0 -3,-1.34 -3,-3s1.34,-3 3,-3 3,1.34 3,3 -1.34,3 -3,3zm3,-10H5V5h10v4z"
                                              Fill="{DynamicResource Text0}" Width="12" Height="12" Stretch="Uniform" Margin="0,0,4,0" VerticalAlignment="Center"/>
                                        <TextBlock Text="Replace" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource Text0}" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Button>
                                <Button x:Name="CompressSaveNewButton" Grid.Column="1" Style="{StaticResource FlatButton}" Margin="3,0,0,0" Padding="4,7" Click="CompressSaveNew_Click"
                                        ToolTip="Compress and save as new clip">
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                        <Path Data="M16,1H4c-1.1,0 -2,0.9 -2,2v14h2V3h12V1zm3,4H8c-1.1,0 -2,0.9 -2,2v14c0,1.1 0.9,2 2,2h11c1.1,0 2,-0.9 2,-2V7c0,-1.1 -0.9,-2 -2,-2zm0,16H8V7h11V21z"
                                              Fill="{DynamicResource Text0}" Width="12" Height="12" Stretch="Uniform" Margin="0,0,4,0" VerticalAlignment="Center"/>
                                        <TextBlock Text="Save New" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource Text0}" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Button>
                            </Grid>

                            <TextBlock x:Name="CompressStatusText" Text="" FontSize="11" Foreground="{DynamicResource Accent}" TextWrapping="Wrap" Margin="0,4,0,0"/>
                        </StackPanel>
                    </Border>
                </Popup>

                <Popup x:Name="BookmarkPopup" PlacementTarget="{Binding ElementName=PlayerMenuPill}" Placement="Bottom"
                       HorizontalOffset="-230" VerticalOffset="8" AllowsTransparency="True" StaysOpen="True" Focusable="False" IsOpen="False">
                    <Border Background="{DynamicResource PanelBgOpaque}" BorderBrush="{DynamicResource Hairline}" BorderThickness="1"
                            Padding="14" Width="260" MaxHeight="340">
                        <Border.Effect>
                            <DropShadowEffect BlurRadius="16" ShadowDepth="3" Color="Black" Opacity="0.6"/>
                        </Border.Effect>
                        <StackPanel>
                            <Grid Margin="0,0,0,10">
                                <TextBlock Text="Bookmarks" FontWeight="Bold" FontSize="13" Foreground="{DynamicResource Text0}" VerticalAlignment="Center"/>
                                <Button Style="{StaticResource BareIconButton}" HorizontalAlignment="Right" Padding="4,2" Click="CloseBookmarkPopup_Click" ToolTip="Close">
                                    <Path Data="M19,6.41L17.59,5 12,10.59 6.41,5 5,6.41 10.59,12 5,17.59 6.41,19 12,13.41 17.59,19 19,17.59 13.41,12z"
                                          Fill="{DynamicResource Text2}" Width="10" Height="10" Stretch="Uniform"/>
                                </Button>
                            </Grid>

                            <Button x:Name="AddBookmarkDialogButton" Style="{StaticResource FlatButton}" Margin="0,0,0,10" Padding="8,7" Click="AddBookmarkDialogButton_Click">
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                    <Path Data="M19,13h-6v6h-2v-6H5v-2h6V5h2v6h6v2z" Fill="{DynamicResource Text0}" Width="12" Height="12" Stretch="Uniform" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                    <TextBlock Text="Add Bookmark" FontSize="11.5" FontWeight="SemiBold" Foreground="{DynamicResource Text0}" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>

                            <Border BorderBrush="{DynamicResource Hairline}" BorderThickness="0,1,0,0" Margin="0,2,0,8"/>

                            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" MaxHeight="190">
                                <StackPanel x:Name="BookmarkListContainer"/>
                            </ScrollViewer>
                        </StackPanel>
                    </Border>
                </Popup>
            </Grid>

    </Grid>
</UserControl>
