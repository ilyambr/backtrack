<UserControl x:Class="Backtrack.UI.Settings.Sections.SettingsAdvancedSection"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <StackPanel Margin="0,0,0,0">
        <Border BorderBrush="{DynamicResource Hairline}" BorderThickness="0,1,0,0" Margin="0,28,0,4"/>

        <Border x:Name="ExperimentalHeader" Margin="0,16,0,0"
                Background="Transparent" Cursor="Hand" MouseLeftButtonUp="ExperimentalHeader_Click">
            <TextBlock x:Name="ExperimentalHeaderText" Text="▸ EXPERIMENTAL" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource Rec}"/>
        </Border>
        <StackPanel x:Name="ExperimentalContent" Visibility="Collapsed" Margin="0,10,0,0">
            <StackPanel x:Name="LocalRamDiskSection">
                <TextBlock Text="RAM DISK" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource Text1}" Margin="0,0,0,10"/>
                <Border Style="{StaticResource SettingsRow}" BorderThickness="0">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="Mount a RAM disk for OBS's replay buffer" FontSize="13" FontWeight="Bold" Foreground="{DynamicResource Text0}"/>
                            <TextBlock x:Name="RamDiskStatusText" Text="Off" FontSize="11" Foreground="{DynamicResource Text2}" Margin="0,3,0,0" TextWrapping="Wrap"/>
                        </StackPanel>
                        <ToggleButton x:Name="RamDiskToggle" Grid.Column="1" Style="{StaticResource AppToggle}" VerticalAlignment="Center" Click="RamDiskToggle_Click"/>
                    </Grid>
                </Border>
                <StackPanel x:Name="RamDiskFields" Visibility="Collapsed" Margin="0,14,0,6">
                    <TextBlock Text="Uses ImDisk (free, open source) to create a virtual RAM drive. Point OBS's Replay Buffer output path (Settings &gt; Output &gt; Replay Buffer) at the drive letter below. That's a one-time manual step; OBS has no API for Backtrack to set it automatically."
                               FontSize="11" Foreground="{DynamicResource Text2}" TextWrapping="Wrap" Margin="0,0,0,10"/>
                    <TextBlock Text="Drive letter and size (MB)" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource Text1}" Margin="0,0,0,6"/>
                    <Grid Margin="0,0,0,6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="60"/>
                            <ColumnDefinition Width="10"/>
                            <ColumnDefinition/>
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="RamDiskDriveBox" Background="{DynamicResource RowBg}" Foreground="{DynamicResource Text0}" CaretBrush="{DynamicResource Text0}" BorderThickness="0" Padding="10,8" MaxLength="1" TextAlignment="Center"/>
                        <TextBox x:Name="RamDiskSizeBox" Grid.Column="2" Background="{DynamicResource RowBg}" Foreground="{DynamicResource Text0}" CaretBrush="{DynamicResource Text0}" BorderThickness="0" Padding="10,8"/>
                    </Grid>
                    <TextBlock Text="Start small and raise it once you've confirmed OBS is actually writing there. A full buffer at high bitrate can need several GB."
                               FontSize="10.5" Foreground="{DynamicResource Text2}" TextWrapping="Wrap" Margin="0,0,0,10"/>
                    <Grid Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="70"/>
                            <ColumnDefinition Width="8"/>
                            <ColumnDefinition/>
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="RamDiskTargetMinutesBox" Background="{DynamicResource RowBg}" Foreground="{DynamicResource Text0}" CaretBrush="{DynamicResource Text0}" BorderThickness="0" Padding="10,8" Text="10"/>
                        <Button Grid.Column="2" Content="Suggest size (minutes above) from OBS's settings" Style="{StaticResource FlatButton}" HorizontalAlignment="Left" Click="SuggestRamDiskSize_Click"/>
                    </Grid>
                    <Button Content="Save &amp; apply" Style="{StaticResource FlatButton}" HorizontalAlignment="Left" Click="ApplyRamDiskSettings_Click"/>
                </StackPanel>
            </StackPanel>

            <StackPanel x:Name="RemoteRamDiskSection" Visibility="Collapsed" Margin="0,0,0,10">
                <TextBlock Text="TRANSMITTER'S RAM DISK" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource Text1}" Margin="0,0,0,10"/>
                <TextBlock x:Name="RemoteRamDiskStatusText" Text="Not paired with a transmitter PC yet." FontSize="11" Foreground="{DynamicResource Text2}" TextWrapping="Wrap" Margin="0,0,0,10"/>
                <StackPanel x:Name="RemoteRamDiskFields" Visibility="Collapsed">
                    <Grid Margin="0,0,0,6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Enabled" FontSize="13" FontWeight="Bold" Foreground="{DynamicResource Text0}" VerticalAlignment="Center"/>
                        <ToggleButton x:Name="RemoteRamDiskToggle" Grid.Column="1" Style="{StaticResource AppToggle}" VerticalAlignment="Center"/>
                    </Grid>
                    <TextBlock Text="Drive letter and size (MB)" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource Text1}" Margin="0,6,0,6"/>
                    <Grid Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="60"/>
                            <ColumnDefinition Width="10"/>
                            <ColumnDefinition/>
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="RemoteRamDiskDriveBox" Background="{DynamicResource RowBg}" Foreground="{DynamicResource Text0}" CaretBrush="{DynamicResource Text0}" BorderThickness="0" Padding="10,8" MaxLength="1" TextAlignment="Center"/>
                        <TextBox x:Name="RemoteRamDiskSizeBox" Grid.Column="2" Background="{DynamicResource RowBg}" Foreground="{DynamicResource Text0}" CaretBrush="{DynamicResource Text0}" BorderThickness="0" Padding="10,8"/>
                    </Grid>
                    <Button Content="Save &amp; apply on transmitter" Style="{StaticResource FlatButton}" HorizontalAlignment="Left" Click="ApplyRemoteRamDiskSettings_Click"/>
                </StackPanel>
            </StackPanel>

            <TextBlock Text="OVERLAY LOG" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource Text1}" Margin="0,24,0,10"/>
            <Border Style="{StaticResource SettingsRow}" BorderThickness="0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="Small log in the corner of the screen" FontSize="13" FontWeight="Bold" Foreground="{DynamicResource Text0}"/>
                        <TextBlock Text="Bottom-right, always visible. OBS mode mirrors OBS's own status bar (encoding overload, saves); Backtrack mode shows Backtrack's own recent activity instead."
                                   FontSize="11" Foreground="{DynamicResource Text2}" Margin="0,3,0,0" TextWrapping="Wrap"/>
                    </StackPanel>
                    <ToggleButton x:Name="OverlayLogToggle" Grid.Column="1" Style="{StaticResource AppToggle}" VerticalAlignment="Center" Click="OverlayLogToggle_Click"/>
                </Grid>
            </Border>
            <StackPanel x:Name="OverlayLogModeFields" Margin="0,14,0,6">
                <TextBlock Text="Mode" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource Text1}" Margin="0,0,0,6"/>
                <ComboBox x:Name="OverlayLogModeSelector" Style="{StaticResource ModernComboBox}" SelectionChanged="OverlayLogModeSelector_SelectionChanged">
                     <ComboBoxItem Content="OBS" Tag="Obs"/>
                     <ComboBoxItem Content="Backtrack" Tag="Backtrack"/>
                 </ComboBox>
            </StackPanel>

            <TextBlock Text="ANIMATIONS" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource Text1}" Margin="0,24,0,10"/>
            <Border Style="{StaticResource SettingsRow}" BorderThickness="0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="Enable animations" FontSize="13" FontWeight="Bold" Foreground="{DynamicResource Text0}"/>
                        <TextBlock Text="Fade/scale transitions between screens and when opening/closing the overlay. Off by default; can look janky depending on your hardware and what's running underneath (a game in particular)."
                                   FontSize="11" Foreground="{DynamicResource Text2}" Margin="0,3,0,0" TextWrapping="Wrap"/>
                    </StackPanel>
                    <ToggleButton x:Name="EnableAnimationsToggle" Grid.Column="1" Style="{StaticResource AppToggle}" VerticalAlignment="Center" Click="EnableAnimationsToggle_Click"/>
                </Grid>
            </Border>

            <TextBlock Text="DIAGNOSTICS" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource Text1}" Margin="0,24,0,10"/>
            <Border Style="{StaticResource SettingsRow}" BorderThickness="0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="Diagnostic log file" FontSize="13" FontWeight="Bold" Foreground="{DynamicResource Text0}"/>
                        <TextBlock Text="Writes what already shows in the bottom-right overlay log to a real file on disk too, so it survives a restart instead of only ever being a glance at recent activity."
                                   FontSize="11" Foreground="{DynamicResource Text2}" Margin="0,3,0,0" TextWrapping="Wrap"/>
                    </StackPanel>
                    <ToggleButton x:Name="DiagnosticLogToggle" Grid.Column="1" Style="{StaticResource AppToggle}" VerticalAlignment="Center" Click="DiagnosticLogToggle_Click"/>
                </Grid>
            </Border>
            <Button x:Name="OpenDiagnosticLogButton" Content="Open log file" Style="{StaticResource FlatButton}" HorizontalAlignment="Left"
                    Margin="0,8,0,0" Visibility="Collapsed" Click="OpenDiagnosticLogButton_Click"/>

            <Border Style="{StaticResource SettingsRow}" BorderThickness="0" Margin="0,14,0,0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="Developer mode" FontSize="13" FontWeight="Bold" Foreground="{DynamicResource Text0}"/>
                        <TextBlock Text="Errors get logged (and shown in dialogs) with full detail, stack trace included. Turns the diagnostic log file on automatically."
                                   FontSize="11" Foreground="{DynamicResource Text2}" Margin="0,3,0,0" TextWrapping="Wrap"/>
                        <TextBlock Text="Enabling this will disable Backtrack updates." FontSize="11" FontWeight="Bold"
                                   Foreground="{DynamicResource Rec}" Margin="0,3,0,0" TextWrapping="Wrap"/>
                        <TextBlock x:Name="DeveloperModeLockedNoteText" Visibility="Collapsed"
                                   Text="Turned on automatically: Backtrack noticed this isn't the installed copy. Feel free to turn it back off; this only happens once."
                                   FontSize="11" Foreground="{DynamicResource Text2}" Margin="0,3,0,0" TextWrapping="Wrap"/>
                    </StackPanel>
                    <ToggleButton x:Name="DeveloperModeToggle" Grid.Column="1" Style="{StaticResource AppToggle}" VerticalAlignment="Center" Click="DeveloperModeToggle_Click"/>
                </Grid>
            </Border>

            <Border Style="{StaticResource SettingsRow}" BorderThickness="0" Margin="0,14,0,0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="Disable hardware acceleration" FontSize="13" FontWeight="Bold" Foreground="{DynamicResource Text0}"/>
                        <TextBlock Text="Forces Backtrack's own rendering onto the CPU instead of the GPU. Only worth trying for actual visual glitches on unusual GPU/driver setups. Makes rendering slower, not faster, and takes effect after restarting."
                                   FontSize="11" Foreground="{DynamicResource Text2}" Margin="0,3,0,0" TextWrapping="Wrap"/>
                    </StackPanel>
                    <ToggleButton x:Name="DisableHardwareAccelToggle" Grid.Column="1" Style="{StaticResource AppToggle}" VerticalAlignment="Center" Click="DisableHardwareAccelToggle_Click"/>
                </Grid>
            </Border>
        </StackPanel>

        <Border x:Name="DestructiveHeader" Margin="0,20,0,0"
                Background="Transparent" Cursor="Hand" MouseLeftButtonUp="DestructiveHeader_Click">
            <TextBlock x:Name="DestructiveHeaderText" Text="▸ MAINTENANCE" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource Rec}"/>
        </Border>
        <StackPanel x:Name="DestructiveContent" Visibility="Collapsed" Margin="0,10,0,0">
            <TextBlock Text="These can't be undone. Each one asks you to confirm first."
                       FontSize="11" Foreground="{DynamicResource Text2}" TextWrapping="Wrap" Margin="0,0,0,14"/>

            <TextBlock Text="DATA &amp; RESET" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource Text1}" Margin="0,0,0,10"/>
            <Border Style="{StaticResource SettingsRow}" BorderThickness="0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="Clear settings cache" FontSize="13" FontWeight="Bold" Foreground="{DynamicResource Text0}"/>
                        <TextBlock Text="Resets settings.json to defaults (hotkey, theme, clips folder path, OBS pairing/connection, everything) and clears cached clip thumbnails/durations. Your actual clips aren't touched. Restarts Backtrack right after."
                                   FontSize="11" Foreground="{DynamicResource Text2}" Margin="0,3,0,0" TextWrapping="Wrap"/>
                    </StackPanel>
                    <Button x:Name="ClearSettingsCacheButton" Grid.Column="1" Content="Reset" Style="{StaticResource FlatButton}" Foreground="{DynamicResource Rec}" VerticalAlignment="Center" Click="ClearSettingsCacheButton_Click"/>
                </Grid>
            </Border>

            <Border Style="{StaticResource SettingsRow}" BorderThickness="0" Margin="0,10,0,0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="Clear clips directory" FontSize="13" FontWeight="Bold" Foreground="{DynamicResource Text0}"/>
                        <TextBlock Text="Deletes every clip (.mp4/.mkv/.flv/.mov) inside your clips folder, recursively. Folders and any other file type in there are left alone completely, even sitting right next to a deleted clip."
                                   FontSize="11" Foreground="{DynamicResource Text2}" Margin="0,3,0,0" TextWrapping="Wrap"/>
                    </StackPanel>
                    <Button x:Name="ClearClipsDirectoryButton" Grid.Column="1" Content="Clear" Style="{StaticResource FlatButton}" Foreground="{DynamicResource Rec}" VerticalAlignment="Center" Click="ClearClipsDirectoryButton_Click"/>
                </Grid>
            </Border>

            <TextBlock Text="UNINSTALL" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource Text1}" Margin="0,20,0,10"/>
            <Border Style="{StaticResource SettingsRow}" BorderThickness="0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="Uninstall Backtrack" FontSize="13" FontWeight="Bold" Foreground="{DynamicResource Text0}"/>
                        <TextBlock Text="Removes Backtrack, its Start Menu shortcut, and its registry entry, then closes the app. Your clips and settings.json are left where they are."
                                   FontSize="11" Foreground="{DynamicResource Text2}" Margin="0,3,0,0" TextWrapping="Wrap"/>
                    </StackPanel>
                    <Button x:Name="UninstallBacktrackButton" Grid.Column="1" Content="Uninstall" Style="{StaticResource FlatButton}" Foreground="{DynamicResource Rec}" VerticalAlignment="Center" Click="UninstallBacktrackButton_Click"/>
                </Grid>
            </Border>

            <Border Style="{StaticResource SettingsRow}" BorderThickness="0" Margin="0,10,0,0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="Uninstall Source Record" FontSize="13" FontWeight="Bold" Foreground="{DynamicResource Text0}"/>
                        <TextBlock Text="Runs the obs-source-record plugin's own uninstaller. Closes OBS first if it's running."
                                   FontSize="11" Foreground="{DynamicResource Text2}" Margin="0,3,0,0" TextWrapping="Wrap"/>
                    </StackPanel>
                    <Button x:Name="UninstallSourceRecordButton" Grid.Column="1" Content="Uninstall" Style="{StaticResource FlatButton}" Foreground="{DynamicResource Rec}" VerticalAlignment="Center" Click="UninstallSourceRecordButton_Click"/>
                </Grid>
            </Border>

            <Border Style="{StaticResource SettingsRow}" BorderThickness="0" Margin="0,10,0,0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="Uninstall Replay Slider" FontSize="13" FontWeight="Bold" Foreground="{DynamicResource Text0}"/>
                        <TextBlock Text="Runs the obs-replay-slider plugin's own uninstaller. Closes OBS first if it's running."
                                   FontSize="11" Foreground="{DynamicResource Text2}" Margin="0,3,0,0" TextWrapping="Wrap"/>
                    </StackPanel>
                    <Button x:Name="UninstallReplaySliderButton" Grid.Column="1" Content="Uninstall" Style="{StaticResource FlatButton}" Foreground="{DynamicResource Rec}" VerticalAlignment="Center" Click="UninstallReplaySliderButton_Click"/>
                </Grid>
            </Border>
        </StackPanel>
    </StackPanel>
</UserControl>
